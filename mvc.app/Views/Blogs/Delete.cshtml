@model mvc.dataaccess.Entities.Blog

@{
    ViewData["Title"] = "Delete Confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        :root {
            --primary-color: #4CAF50;
            --primary-light: #81C784;
            --primary-dark: #388E3C;
            --primary-darker: #2E7D32;
            --primary-bg: #E8F5E9;
            --secondary-color: #6c757d;
            --danger-color: #dc3545;
            --danger-dark: #c82333;
            --danger-light: #fee;
            --warning-color: #FFC107;
            --warning-light: #fff3cd;
            --light-bg: #f5f9f5;
            --white: #ffffff;
            --text-dark: #2c3e50;
            --text-muted: #6c757d;
            --shadow: 0 2px 8px rgba(0,0,0,0.08);
            --shadow-hover: 0 4px 16px rgba(0,0,0,0.12);
            --border-radius: 12px;
        }

        body {
            background-color: var(--light-bg);
        }

        /* Container */
        .delete-container {
            max-width: 700px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        /* Delete Card */
        .delete-card {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            border: 1px solid rgba(220, 53, 69, 0.1);
            animation: fadeInUp 0.5s ease-out;
        }

        @@keyframes fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .delete-header {
            background: linear-gradient(135deg, var(--danger-color) 0%, var(--danger-dark) 100%);
            color: white;
            padding: 2rem;
            text-align: center;
        }

            .delete-header h1 {
                margin: 0;
                font-size: 2rem;
                font-weight: 600;
            }

            .delete-header p {
                margin: 0.5rem 0 0 0;
                opacity: 0.9;
                font-size: 1.1rem;
            }

        .warning-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.1);
        }

        100% {
            transform: scale(1);
        }

        }

        /* Content */
        .delete-content {
            padding: 2rem;
        }

        .blog-preview {
            background: var(--light-bg);
            border: 1px solid rgba(76, 175, 80, 0.2);
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .preview-label {
            font-weight: 600;
            color: var(--primary-darker);
            margin-bottom: 0.5rem;
            display: block;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .preview-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 1rem;
        }

        .preview-content {
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.6;
            max-height: 100px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .preview-image {
            margin-top: 1rem;
            text-align: center;
        }

            .preview-image img {
                max-width: 100%;
                max-height: 200px;
                object-fit: cover;
                border-radius: 8px;
                box-shadow: var(--shadow);
            }

        .blog-meta {
            display: flex;
            gap: 2rem;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid #dee2e6;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .meta-item i {
                color: var(--primary-color);
            }

        /* Warning Message */
        .warning-message {
            background: var(--danger-light);
            border: 1px solid #f5c6cb;
            color: var(--danger-color);
            padding: 1rem 1.5rem;
            border-radius: 8px;
            margin-bottom: 2rem;
            display: flex;
            align-items: start;
            gap: 1rem;
        }

            .warning-message i {
                font-size: 1.5rem;
                margin-top: 0.2rem;
            }

        .warning-text {
            flex: 1;
        }

            .warning-text strong {
                display: block;
                margin-bottom: 0.5rem;
            }

        /* Actions */
        .delete-actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            padding: 2rem;
            background: var(--light-bg);
            border-top: 1px solid #dee2e6;
        }

        .btn {
            padding: 0.75rem 2rem;
            font-size: 1rem;
            font-weight: 500;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-delete {
            background: var(--danger-color);
            color: white;
        }

            .btn-delete:hover {
                background: var(--danger-dark);
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
            }

        .btn-cancel {
            background: white;
            color: var(--secondary-color);
            border: 1px solid #dee2e6;
        }

            .btn-cancel:hover {
                background: var(--secondary-color);
                color: white;
                border-color: var(--secondary-color);
                transform: translateY(-2px);
            }

        /* Breadcrumb */
        .breadcrumb-container {
            background: white;
            padding: 1rem 0;
            margin-bottom: 1.5rem;
            border-bottom: 1px solid rgba(76, 175, 80, 0.1);
        }

        .breadcrumb {
            max-width: 700px;
            margin: 0 auto;
            padding: 0 1rem;
            display: flex;
            align-items: center;
            font-size: 0.9rem;
        }

        .breadcrumb-item {
            color: var(--text-muted);
        }

            .breadcrumb-item + .breadcrumb-item::before {
                content: "/";
                color: var(--text-muted);
                margin: 0 0.5rem;
            }

        .breadcrumb a {
            color: var(--primary-dark);
            text-decoration: none;
            font-weight: 500;
        }

            .breadcrumb a:hover {
                color: var(--primary-color);
                text-decoration: underline;
            }

        .breadcrumb-item.active {
            color: var(--danger-color);
            font-weight: 600;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .delete-container

        {
            margin: 0;
            padding: 0;
        }

        .delete-card {
            border-radius: 0;
            box-shadow: none;
        }

        .delete-actions {
            flex-direction: column-reverse;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }

        .blog-meta {
            flex-direction: column;
            gap: 0.5rem;
        }

        }
    </style>
}

<nav aria-label="breadcrumb" class="breadcrumb-container">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Blogs")"><i class="bi bi-house-door"></i> Blogs</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("AdminBlog", "Blogs")">Admin</a></li>
        <li class="breadcrumb-item active" aria-current="page">Delete</li>
    </ol>
</nav>

<div class="delete-container">
    <div class="delete-card">
        <div class="delete-header">
            <i class="fas fa-exclamation-triangle warning-icon"></i>
            <h1>Delete Confirmation</h1>
            <p>Are you sure you want to delete this blog post?</p>
        </div>

        <div class="delete-content">
            <div class="blog-preview">
                <span class="preview-label">Blog Post to Delete</span>
                <h2 class="preview-title">@(Model?.title ?? "Untitled")</h2>

                <div class="preview-content">
                    @{
                        var contentPreview = "";
                        if (!string.IsNullOrEmpty(Model?.blog_content))
                        {
                            // Remove HTML tags for preview
                            contentPreview = System.Text.RegularExpressions.Regex.Replace(Model.blog_content, @"<[^>]+>", " ");
                            contentPreview = System.Text.RegularExpressions.Regex.Replace(contentPreview, @"\s+", " ").Trim();

                            if (contentPreview.Length > 200)
                            {
                                contentPreview = contentPreview.Substring(0, 200) + "...";
                            }
                        }
                        else
                        {
                            contentPreview = "No content available";
                        }
                    }
                    @contentPreview
                </div>

                @if (Model?.ImageData != null && Model.ImageData.Length > 0)
                {
                    <div class="preview-image">
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.ImageData)"
                             alt="Blog featured image" />
                    </div>
                }

                <div class="blog-meta">
                    <div class="meta-item">
                        <i class="bi bi-calendar"></i>
                        <span>Created: @DateTime.Now.ToString("MMM dd, yyyy")</span>
                    </div>
                    @if (Model?.blog_content?.Contains("<img") == true)
                    {
                        <div class="meta-item">
                            <i class="bi bi-image"></i>
                            <span>Contains images</span>
                        </div>
                    }
                </div>
            </div>

            <div class="warning-message">
                <i class="bi bi-exclamation-circle-fill"></i>
                <div class="warning-text">
                    <strong>This action cannot be undone!</strong>
                    Once deleted, this blog post and all its content will be permanently removed from the system.
                </div>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="delete-actions">
                <a href="/Blogs/AdminBlog" class="btn btn-cancel">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
                <button type="submit" class="btn btn-delete" id="deleteBtn">
                    <i class="bi bi-trash"></i> Yes, Delete This Post
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <script>
        // Add final confirmation and loading state
        document.querySelector('form').addEventListener('submit', function(e) {
            e.preventDefault();

            const deleteBtn = document.getElementById('deleteBtn');

            if (confirm('Final confirmation: Delete this blog post?')) {
                // Show loading state
                deleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Deleting...';
                deleteBtn.disabled = true;

                // Submit the form
                this.submit();
            }
        });
    </script>
}