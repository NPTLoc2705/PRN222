<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Drug-Free World</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            line-height: 1.6;
            color: #333;
            padding-top: 80px; /* Account for fixed header */
        }

        /* Header */
        header {
            background: #fff;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
        }

        .header-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 20px;
        }

        .logo img {
            height: 50px;

        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 20px;
            align-items: center;
        }

            nav ul li a {
                text-decoration: none;
                color: #333;
                font-weight: bold;
                font-size: 16px;
                transition: color 0.3s;
            }

                nav ul li a:hover {
                    color: #00a79d;
                }

        .user-welcome {
            color: #00a79d;
            font-weight: bold;
            font-size: 16px;
            padding: 8px 12px;
            background: #f0f9f8;
            border-radius: 5px;
        }

        /* Footer */
        footer {
            background: #333;
            color: #fff;
            padding: 20px;
            text-align: center;
            margin-top: 0;
        }

            footer a {
                color: #00a79d;
                text-decoration: none;
            }

                footer a:hover {
                    text-decoration: underline;
                }

        /* Override Bootstrap container for full-width content when needed */
        .container-fluid-custom {
            padding: 0;
            margin: 0;
            max-width: none;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .header-container

        {
            flex-direction: column;
            gap: 10px;
        }

        nav ul {
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
        }

        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Fix browser refresh warning (if needed for hot reload) -->
    <script src="/_framework/aspnetcore-browser-refresh.js"></script>

    <header>
        <div class="header-container">
            <div class="logo">
                <img src="~/logo.png" alt="Drug Free World Logo">
            </div>
            <nav>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a href="/Blogs">Blog</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy">Contact</a></li>
                    <li><a asp-controller="Courses" asp-action="Index">Course</a></li>
                    <li><a asp-controller="Bookings" asp-action="ConsultanView">Booking</a></li>

                    @if (ViewData["IsLoggedIn"] != null && (bool)ViewData["IsLoggedIn"])
                    {
                        <li><span class="user-welcome">@ViewData["UserMessage"]</span></li>
                        <li><a asp-controller="Auth" asp-action="Logout">Logout</a></li>
                    }
                    else
                    {
                        <li><a asp-controller="Auth" asp-action="Login">Login</a></li>
                        <li><a asp-controller="Auth" asp-action="Register">Register</a></li>
                    }
                </ul>
            </nav>
        </div>
    </header>

    <!-- Main content area - NO CONTAINER for full-width pages -->
    <main role="main">
        @RenderBody()
    </main>

    <footer>
        <p>&copy; 2025 Drug-Free World. All rights reserved. | <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a> | <a href="#">Contact Us</a></p>
    </footer>

    <!-- Bootstrap 5 JS (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Your custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Basic JavaScript for smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>