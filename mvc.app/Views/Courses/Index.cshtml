@model IEnumerable<mvc.dataaccess.Entities.Courses.Course>

@{
    ViewData["Title"] = "Courses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .course-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .course-card {
            position: relative;

            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .course-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

        .course-image {
            height: 200px;
            width: 100%;
            object-fit: cover;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 3rem;
        }

        .course-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .course-body {
            padding: 1.5rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .course-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #2d3748;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .course-description {
            color: #718096;
            margin-bottom: 1rem;
            flex: 1;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .course-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            font-size: 0.875rem;
            color: #a0aec0;
        }

        .course-duration {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .difficulty-badge {
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
        }

        .difficulty-beginner {
            background-color: #c6f6d5;
            color: #276749;
        }

        .difficulty-intermediate {
            background-color: #fefcbf;
            color: #744210;
        }

        .difficulty-advanced {
            background-color: #fed7d7;
            color: #742a2a;
        }

        .course-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: auto;
        }

        .btn-course {
            flex: 1;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            text-align: center;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-primary-course {
            background-color: #4299e1;
            color: white;
        }

        .btn-primary-course:hover {
            background-color: #3182ce;
            color: white;
        }

        .btn-secondary-course {
            background-color: #e2e8f0;
            color: #4a5568;
        }

        .btn-secondary-course:hover {
            background-color: #cbd5e0;
            color: #2d3748;
        }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: #718096;
        }

        .empty-state i {
            font-size: 4rem;
            color: #cbd5e0;
            margin-bottom: 1rem;
        }

        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #e2e8f0;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            color: #2d3748;
            margin: 0;
        }

        .inactive-badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background-color: #fc8181;
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        @@media (max-width: 768px) {
            .course-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .header-section {
                flex-direction: column;
                gap: 1rem;
                align-items: stretch;
            }
        }
    </style>
}

<div class="container py-4">
    <div class="header-section">
        <h1 class="page-title">
            <i class="bi bi-mortarboard-fill me-2"></i>Courses
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Create New Course
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="course-grid">
            @foreach (var course in Model)
            {
                <div class="course-card">
                    @if (!course.IsActive)
                    {
                        <span class="inactive-badge">Inactive</span>
                    }

                    <div class="course-image">
                        @if (course.ImageBytes != null && course.ImageBytes.Length > 0)
                        {
                            <img src="@Url.Action("GetCourseImage", new { id = course.CourseId })" alt="@course.Title" />
                        }
                        else
                        {
                            <i class="bi bi-book"></i>
                        }
                    </div>
            @functions {
                public static string StripHtml(string input)
                {
                    return System.Text.RegularExpressions.Regex.Replace(input ?? "", "<.*?>", "");
                }
            } 
                    <div class="course-body">
                        <h3 class="course-title">@course.Title</h3>
                        <p class="course-description">@StripHtml(course.Description)</p>

                        <div class="course-meta">
                            <div class="course-duration">
                                <i class="bi bi-clock"></i>
                                <span>@course.Duration min</span>
                            </div>
                            <span class="difficulty-badge difficulty-@course.DifficultyLevel.ToLower()">
                                @course.DifficultyLevel
                            </span>
                        </div>

                        <div class="course-actions">
                            <a asp-action="Details" asp-route-id="@course.CourseId" class="btn-course btn-primary-course">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                            <a asp-action="Edit" asp-route-id="@course.CourseId" class="btn-course btn-secondary-course">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-journal-x"></i>
            <h3>No courses available</h3>
            <p>Get started by creating your first course.</p>
            <a asp-action="Create" class="btn btn-primary mt-3">
                <i class="bi bi-plus-circle me-2"></i>Create First Course
            </a>
        </div>
    }
</div>