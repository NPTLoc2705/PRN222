@model mvc.dataaccess.Entities.Courses.Course

@{
    ViewData["Title"] = "Delete Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        :root {
            --primary-color: #4CAF50;
            --primary-light: #81C784;
            --primary-dark: #388E3C;
            --danger-color: #dc3545;
            --danger-light: #f8d7da;
            --danger-dark: #721c24;
            --secondary-color: #6c757d;
            --light-bg: #f5f9f5;
            --white: #ffffff;
            --text-dark: #2c3e50;
            --text-muted: #6c757d;
            --shadow: 0 2px 8px rgba(0,0,0,0.08);
            --shadow-hover: 0 4px 16px rgba(0,0,0,0.12);
            --border-radius: 12px;
        }

        body {
            background-color: var(--light-bg);
        }

        .delete-container {
            max-width: 600px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .delete-card {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            animation: fadeInUp 0.5s ease-out;
        }

        @@keyframes fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .delete-header {
            background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
            padding: 2rem;
            text-align: center;
            border-bottom: 3px solid var(--danger-color);
        }

        .delete-icon {
            font-size: 3rem;
            color: var(--danger-color);
            margin-bottom: 1rem;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        100% {
            transform: scale(1);
        }

        }

        .delete-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--danger-dark);
            margin: 0;
        }

        .delete-body {
            padding: 2rem;
        }

        .warning-message {
            background: var(--danger-light);
            border: 1px solid #f5c6cb;
            color: var(--danger-dark);
            padding: 1rem 1.25rem;
            border-radius: 8px;
            margin-bottom: 2rem;
            display: flex;
            align-items: start;
            gap: 0.75rem;
        }

        .warning-icon {
            color: var(--danger-color);
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .course-details {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            border: 1px solid #e9ecef;
        }

        .course-title-display {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 0.75rem;
        }

        .course-description-display {
            color: var(--text-muted);
            margin-bottom: 1.5rem;
            line-height: 1.6;
        }

        .detail-item {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem 0;
            border-bottom: 1px solid #e9ecef;
        }

            .detail-item:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .detail-label i {
                color: var(--primary-color);
                font-size: 0.9rem;
            }

        .detail-value {
            color: var(--text-dark);
            text-align: right;
        }

        .badge {
            padding: 0.35em 0.65em;
            border-radius: 50px;
            font-size: 0.875rem;
            font-weight: 500;
        }

            .badge.bg-success {
                background-color: var(--primary-color) !important;
            }

        .affected-items {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 8px;
            padding: 1rem 1.25rem;
            margin-bottom: 2rem;
        }

        .affected-title {
            font-weight: 600;
            color: #856404;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .affected-title i {
                color: #f39c12;
            }

        .affected-list {
            margin: 0;
            padding-left: 1.5rem;
            color: #856404;
            font-size: 0.95rem;
        }

            .affected-list li {
                margin-bottom: 0.25rem;
            }

        .delete-actions {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            flex: 1;
            text-decoration: none;
            text-align: center;
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-delete {
            background-color: var(--danger-color);
            color: white;
        }

            .btn-delete:hover {
                background-color: #c82333;
                transform: translateY(-2px);
                box-shadow: var(--shadow-hover);
            }

        .btn-cancel {
            background-color: white;
            color: var(--secondary-color);
            border: 1px solid #dee2e6;
        }

            .btn-cancel:hover {
                background-color: var(--secondary-color);
                color: white;
                border-color: var(--secondary-color);
                transform: translateY(-2px);
            }

        /* Loading state */
        .btn-delete:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        @@media (max-width: 768px) {
            .delete-container

        {
            margin: 1rem auto;
        }

        .delete-header {
            padding: 1.5rem;
        }

        .delete-body {
            padding: 1.5rem;
        }

        .delete-actions {
            flex-direction: column-reverse;
        }

        .detail-item {
            flex-direction: column;
            gap: 0.25rem;
        }

        .detail-value {
            text-align: left;
        }

        }
    </style>
}

<div class="container py-4">
    <div class="delete-container">
        <div class="delete-card">
            <div class="delete-header">
                <i class="bi bi-exclamation-triangle-fill delete-icon"></i>
                <h1 class="delete-title">Delete Course</h1>
            </div>

            <div class="delete-body">
                <div class="warning-message">
                    <i class="bi bi-exclamation-circle-fill warning-icon"></i>
                    <div>
                        <strong>Warning:</strong> This action cannot be undone. All associated lessons and student progress data will be permanently deleted.
                    </div>
                </div>

                <div class="course-details">
                    <h2 class="course-title-display">@Model.Title</h2>
                    <div class="course-description-display">
                        @Html.Raw(System.Text.RegularExpressions.Regex.Replace(Model.Description ?? "", "<.*?>", string.Empty))
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="bi bi-clock"></i> Duration
                        </span>
                        <span class="detail-value">@Model.Duration minutes</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="bi bi-speedometer2"></i> Difficulty Level
                        </span>
                        <span class="detail-value">@Model.DifficultyLevel</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="bi bi-toggle-on"></i> Status
                        </span>
                        <span class="detail-value">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="bi bi-calendar-plus"></i> Created
                        </span>
                        <span class="detail-value">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>

                @if (Model.Lessons != null && Model.Lessons.Any())
                {
                    <div class="affected-items">
                        <div class="affected-title">
                            <i class="bi bi-info-circle"></i>
                            This course contains:
                        </div>
                        <ul class="affected-list">
                            <li>@Model.Lessons.Count() lesson(s)</li>
                            <li>All associated student progress records</li>
                            <li>All enrollment data</li>
                        </ul>
                    </div>
                }

                <form id="deleteForm"
                      method="post"
                      action="/Courses/DeleteConfirmed/@Model.CourseId">
                    @Html.AntiForgeryToken()

                    <div class="delete-actions">
                        <a asp-action="Index" asp-controller="Admin" class="btn btn-cancel">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-delete" id="deleteBtn">
                            <i class="bi bi-trash"></i> Delete Course
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteForm = document.getElementById('deleteForm');
            const deleteBtn = document.getElementById('deleteBtn');

            deleteBtn.addEventListener('click', function (e) {
                e.preventDefault();

                if (confirm('Are you absolutely sure you want to delete this course?\n\nThis action cannot be undone and will delete all associated lessons and student progress.')) {
                    deleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Deleting...';
                    deleteBtn.disabled = true;

                    deleteForm.submit();
                }
            });
        });
    </script>
}