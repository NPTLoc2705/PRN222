@model mvc.dataaccess.Entities.Courses.Course

@{
    ViewData["Title"] = "Delete Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .delete-container {
            max-width: 600px;
            margin: 0 auto;
        }

        .delete-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .delete-header {
            background: #fed7d7;
            padding: 2rem;
            text-align: center;
            border-bottom: 3px solid #fc8181;
        }

        .delete-icon {
            font-size: 3rem;
            color: #e53e3e;
            margin-bottom: 1rem;
        }

        .delete-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #742a2a;
            margin: 0;
        }

        .delete-body {
            padding: 2rem;
        }

        .warning-message {
            background: #fffaf0;
            border: 1px solid #feb2b2;
            color: #7c2d12;
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 2rem;
            display: flex;
            align-items: start;
            gap: 0.75rem;
        }

        .warning-icon {
            color: #f56565;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .course-details {
            background: #f7fafc;
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .detail-item {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem 0;
            border-bottom: 1px solid #e2e8f0;
        }

            .detail-item:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: #4a5568;
        }

        .detail-value {
            color: #2d3748;
            text-align: right;
        }

        .course-title-display {
            font-size: 1.25rem;
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 0.5rem;
        }

        .course-description-display {
            color: #718096;
            margin-bottom: 1rem;
        }

        .affected-items {
            background: #fff5f5;
            border: 1px solid #feb2b2;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 2rem;
        }

        .affected-title {
            font-weight: 600;
            color: #c53030;
            margin-bottom: 0.5rem;
        }

        .affected-list {
            margin: 0;
            padding-left: 1.5rem;
            color: #742a2a;
        }

        .delete-actions {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }

        .btn-delete {
            background-color: #e53e3e;
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            flex: 1;
        }

            .btn-delete:hover {
                background-color: #c53030;
                transform: translateY(-1px);
            }

        .btn-cancel {
            background-color: #e2e8f0;
            color: #4a5568;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-weight: 500;
            text-decoration: none;
            text-align: center;
            transition: all 0.2s;
            flex: 1;
        }

            .btn-cancel:hover {
                background-color: #cbd5e0;
                color: #2d3748;
            }

        @@media (max-width: 768px) {
            .delete-container {
                padding: 0 1rem;
            }

            .delete-actions {
                flex-direction: column-reverse;
            }

            .detail-item {
                flex-direction: column;
                gap: 0.25rem;
            }

            .detail-value {
                text-align: left;
            }
        }
    </style>
}

<div class="container py-4">
    <div class="delete-container">
        <div class="delete-card">
            <div class="delete-header">
                <i class="bi bi-exclamation-triangle-fill delete-icon"></i>
                <h1 class="delete-title">Delete Course</h1>
            </div>

            <div class="delete-body">
                <div class="warning-message">
                    <i class="bi bi-info-circle-fill warning-icon"></i>
                    <div>
                        <strong>Warning:</strong> This action cannot be undone. All associated modules, lessons, and progress data will be permanently deleted.
                    </div>
                </div>

                <div class="course-details">
                    <h2 class="course-title-display">@Model.Title</h2>
                    <p class="course-description-display">@Model.Description</p>

                    <div class="detail-item">
                        <span class="detail-label">Duration</span>
                        <span class="detail-value">@Model.Duration minutes</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Difficulty Level</span>
                        <span class="detail-value">@Model.DifficultyLevel</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Status</span>
                        <span class="detail-value">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Created</span>
                        <span class="detail-value">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>

                @if (Model.Lessons != null && Model.Lessons.Any())
                {
                    <div class="affected-items">
                        <div class="affected-title">This course contains:</div>
                        <ul class="affected-list">
                            <li>@Model.Lessons.Count() module(s)</li>
                            <li>All associated lessons</li>
                            <li>All student progress records</li>
                        </ul>
                    </div>
                }

                <form asp-action="Delete" method="post" onsubmit="return confirmDelete()">
                    <input type="hidden" asp-for="CourseId" />

                    <div class="delete-actions">
                        <a asp-action="Index" asp-controller="Admin" class="btn-cancel">
                            <i class="bi bi-arrow-left me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn-delete">
                            <i class="bi bi-trash me-2"></i>Delete Course
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            return confirm('Are you sure you want to delete this course? This action cannot be undone.');
        }
    </script>
}