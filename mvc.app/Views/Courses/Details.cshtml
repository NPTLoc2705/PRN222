@model mvc.dataaccess.Entities.Courses.Course

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .course-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 3rem 0;
            border-radius: 16px;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

            .course-header::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -10%;
                width: 50%;
                height: 200%;
                background: rgba(255,255,255,0.1);
                transform: rotate(45deg);
            }

        .course-header-content {
            position: relative;
            z-index: 1;
            padding: 0 2rem;
        }

        .course-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .course-meta {
            display: flex;
            gap: 2rem;
            align-items: center;
            flex-wrap: wrap;
            opacity: 0.9;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .difficulty-badge {
            padding: 0.5rem 1rem;
            background: rgba(255,255,255,0.2);
            border-radius: 9999px;
            font-weight: 500;
        }

        .course-content {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 2rem;
            margin-top: 2rem;
        }

        .main-content {
            background: white;
            border-radius: 12px;
            padding: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .sidebar {
            height: fit-content;
        }

        .course-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 1.5rem;
            background: #f7fafc;
        }

        .action-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            margin-bottom: 1.5rem;
        }

        .action-buttons {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .modules-section {
            margin-top: 3rem;
        }

        .modules-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .module-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .module-item {
            background: #f7fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s;
        }

            .module-item:hover {
                background: #edf2f7;
                transform: translateX(5px);
            }

        .module-info {
            flex: 1;
        }

        .module-number {
            font-size: 0.875rem;
            color: #718096;
            margin-bottom: 0.25rem;
        }

        .module-title {
            font-size: 1.125rem;
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 0.5rem;
        }

        .module-description {
            color: #718096;
            font-size: 0.875rem;
        }

        .module-actions {
            display: flex;
            gap: 0.5rem;
        }

        .empty-modules {
            text-align: center;
            padding: 3rem;
            background: #f7fafc;
            border-radius: 8px;
            color: #718096;
        }

        .description-section {
            margin-bottom: 2rem;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: #2d3748;
        }

        .status-badge {
            padding: 0.25rem 0.75rem;
            border-radius: 4px;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .status-active {
            background-color: #c6f6d5;
            color: #276749;
        }

        .status-inactive {
            background-color: #fed7d7;
            color: #742a2a;
        }

        @@media (max-width: 768px) {
            .course-content {
                grid-template-columns: 1fr;
            }

            .course-title {
                font-size: 1.75rem;
            }

            .course-meta {
                gap: 1rem;
            }

            .module-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .module-actions {
                width: 100%;
            }

                .module-actions .btn {
                    flex: 1;
                }
        }
    </style>
}

<div class="container py-4">
    <!-- Course Header -->
    <div class="course-header">
        <div class="course-header-content">
            <h1 class="course-title">@Model.Title</h1>
            <div class="course-meta">
                <div class="meta-item">
                    <i class="bi bi-clock"></i>
                    <span>@Model.Duration minutes</span>
                </div>
                <div class="meta-item">
                    <span class="difficulty-badge">@Model.DifficultyLevel</span>
                </div>
                <div class="meta-item">
                    @if (Model.IsActive)
                    {
                        <span class="status-badge status-active">Active</span>
                    }
                    else
                    {
                        <span class="status-badge status-inactive">Inactive</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="course-content">
        <!-- Main Content -->
        <div class="main-content">
            <!-- Description -->
            <div class="description-section">
                <h2 class="section-title">About this course</h2>
                <div>@Html.Raw(Model.Description)</div>
            </div>

            <!-- Modules -->
            <div class="modules-section">
                <div class="modules-header">
                    <h2 class="section-title mb-0">Course Modules</h2>
                    <a asp-controller="Modules" asp-action="Create" asp-route-courseId="@Model.CourseId" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>Add Module
                    </a>
                </div>

                @if (Model.Modules != null && Model.Modules.Any())
                {
                    <div class="module-list">
                        @foreach (var module in Model.Modules.OrderBy(m => m.OrderNumber))
                        {
                            <div class="module-item">
                                <div class="module-info">
                                    <div class="module-number">Module @module.OrderNumber</div>
                                    <h3 class="module-title">@module.Title</h3>
                                    <p class="module-description">@module.Description</p>
                                </div>
                                <div class="module-actions">
                                    <a asp-controller="Modules" asp-action="Details"
                                       asp-route-courseId="@Model.CourseId"
                                       asp-route-moduleId="@module.ModuleId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-controller="Modules" asp-action="Edit"
                                       asp-route-courseId="@Model.CourseId"
                                       asp-route-moduleId="@module.ModuleId"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-modules">
                        <i class="bi bi-folder2-open" style="font-size: 3rem;"></i>
                        <p class="mt-3">No modules added yet</p>
                        <a asp-controller="Modules" asp-action="Create" asp-route-courseId="@Model.CourseId" class="btn btn-primary mt-2">
                            <i class="bi bi-plus-circle me-1"></i>Add First Module
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar -->
        <div class="sidebar">
            <!-- Course Image -->
            @if (Model.ImageBytes != null && Model.ImageBytes.Length > 0)
            {
                <img src="@Url.Action("GetCourseImage", new { id = Model.CourseId })"
                     alt="@Model.Title"
                     class="course-image" />
            }

            <!-- Actions -->
            <div class="action-card">
                <h3 class="section-title">Actions</h3>
                <div class="action-buttons">
                    <a asp-action="Edit" asp-route-id="@Model.CourseId" class="btn btn-primary">
                        <i class="bi bi-pencil me-2"></i>Edit Course
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.CourseId" class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Delete Course
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </div>

            <!-- Course Info -->
            <div class="action-card">
                <h3 class="section-title">Course Information</h3>
                <dl class="mb-0">
                    <dt class="text-muted">Created</dt>
                    <dd>@Model.CreatedAt.ToString("MMM dd, yyyy")</dd>

                    <dt class="text-muted mt-3">Last Updated</dt>
                    <dd>@Model.UpdatedAt.ToString("MMM dd, yyyy")</dd>

                    <dt class="text-muted mt-3">Total Modules</dt>
                    <dd>@(Model.Modules?.Count ?? 0)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>