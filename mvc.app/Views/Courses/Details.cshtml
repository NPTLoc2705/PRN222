@model mvc.dataaccess.Entities.Courses.Course

@{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    ViewData["Title"] = "Course Details";
    var userId = Context.Session.GetString("UserId");
    bool isLoggedIn = !string.IsNullOrEmpty(userId);
    bool isEnrolled = ViewBag.IsEnrolled ?? false;
    decimal progressPercentage = ViewBag.ProgressPercentage ?? 0;
    var completedLessonIds = ViewBag.CompletedLessonIds as List<Guid> ?? new List<Guid>();
    var isAdmin = Context.Session.GetString("UserRole") == "Member" ||
                 Context.Session.GetString("UserRole") == "Instructor";
}

<style>
    :root {
        --primary-color: #28a745; /* green */
        --secondary-color: #6c757d;
        --success-color: #20c997;
        --info-color: #17a2b8;
        --warning-color: #ffc107;
        --danger-color: #dc3545;
        --light-color: #f9fef9;
        --dark-color: #343a40;
    }

    body {
        background-color: #f0fff0; /* bland green */
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .course-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #cce5cc;
    }

    .course-image {
        border-radius: 8px;
        box-shadow: 0 0 20px rgba(0, 128, 0, 0.1);
        margin-bottom: 1.5rem;
        transition: transform 0.3s ease;
    }

        .course-image:hover {
            transform: scale(1.01);
        }

    .card {
        border: 1px solid #c8e6c9;
        border-radius: 0.5rem;
        box-shadow: 0 0.125rem 0.75rem rgba(0, 128, 0, 0.08);
        margin-bottom: 1.5rem;
        transition: transform 0.2s ease;
        background-color: #ffffff;
    }

        .card:hover {
            transform: translateY(-3px);
        }

    .card-header {
        background-color: #e6f5e6;
        border-bottom: 1px solid #b2dfdb;
        font-weight: 600;
    }

    .progress {
        height: 1.25rem;
        background-color: #e8f5e9;
        border-radius: 0.25rem;
    }

    .progress-bar {
        background-color: var(--primary-color);
        font-size: 0.8rem;
        font-weight: 600;
    }

    .list-group-item {
        border: 1px solid #e0f2f1;
        padding: 1.1rem;
        margin-bottom: 0.5rem;
        border-radius: 0.45rem !important;
        transition: background 0.3s, transform 0.2s;
    }

        .list-group-item:hover {
            background-color: #f1f8f5;
            transform: translateX(4px);
        }

    .list-group-item-success {
        background-color: #d9f9d9;
        border-left: 4px solid var(--success-color);
    }

    .badge {
        padding: 0.4em 0.75em;
        font-size: 0.8rem;
    }

    .btn-primary {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

        .btn-primary:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }

    .btn-lg {
        padding: 0.75rem 1.5rem;
        font-size: 1.05rem;
    }

    .category-badge {
        background-color: #dcfce7;
        color: #1f8f3c;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .enroll-section {
        background: linear-gradient(135deg, #e9fbe9 0%, #ffffff 100%);
        border-radius: 0.5rem;
        padding: 2rem;
        text-align: center;
        box-shadow: inset 0 0 8px rgba(0, 128, 0, 0.05);
    }

    .lesson-icon {
        margin-right: 0.6rem;
        width: 24px;
        text-align: center;
        font-size: 1.2rem;
    }

    .text-muted {
        color: #6c757d !important;
    }

    .btn-block {
        width: 100%;
    }

    .top-50 {
        top: 50%;
    }

    .start-50 {
        left: 50%;
    }

    .translate-middle {
        transform: translate(-50%, -50%);
    }
</style>

<div class="container py-4">
    <div class="mb-4">
        <a href="@Url.Action("Index", "Courses")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left mr-2"></i> Return to Courses List
        </a>
    </div>
    <div class="course-header">
        <h1 class="display-4 font-weight-bold text-dark">@Model.Title</h1>
        @if (Model.IsActive)
        {
            <span class="badge bg-success"><i class="fas fa-check-circle mr-1"></i> Active</span>
        }
        else
        {
            <span class="badge bg-secondary"><i class="fas fa-pause-circle mr-1"></i> Inactive</span>
        }
    </div>

    @if (Model.ImageBytes != null && Model.ImageBytes.Length > 0)
    {
        <img src="@Url.Action("GetCourseImage", "Courses", new { id = Model.CourseId })"
             alt="@Model.Title" class="course-image img-fluid" style="max-height: 400px; width: 100%; object-fit: cover;" />
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-info-circle mr-2"></i>Course Description</h5>
                </div>
                <div class="card-body">
                    <p class="card-text lead">@Model.Description</p>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-clock fa-lg text-primary mr-3"></i>
                                <div>
                                    <h6 class="mb-0">Duration</h6>
                                    <p class="text-muted mb-0">@Model.Duration minutes</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-tachometer-alt fa-lg text-primary mr-3"></i>
                                <div>
                                    <h6 class="mb-0">Difficulty</h6>
                                    <p class="text-muted mb-0">@Model.DifficultyLevel</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-tags mr-2"></i>Categories</h5>
                </div>
                <div class="card-body">
                    @if (Model.CategoryMappings?.Any() ?? false)
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var category in Model.CategoryMappings.Select(cm => cm.Category))
                            {
                                <span class="category-badge">
                                    <i class="fas fa-tag mr-1"></i>@category.Name
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <i class="fas fa-tags fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-0">No categories assigned</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            @if (isLoggedIn)
            {
                if (!isEnrolled)
                {
                    <div class="card">
                        <div class="card-body text-center enroll-section">
                            <i class="fas fa-graduation-cap fa-3x mb-3 text-primary"></i>
                            <h4 class="mb-3">Ready to start learning?</h4>
                            <form asp-action="Enroll" method="post">
                                <input type="hidden" name="courseId" value="@Model.CourseId" />
                                <button type="submit" class="btn btn-primary btn-lg btn-block py-3">
                                    <i class="fas fa-user-plus mr-2"></i> Enroll Now
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="fas fa-chart-line mr-2"></i>Your Progress</h5>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-3">
                                <div class="position-relative d-inline-block">
                                    <svg width="120" height="120" viewBox="0 0 120 120" class="circular-progress">
                                        <circle cx="60" cy="60" r="54" fill="none" stroke="#e6e6e6" stroke-width="8"></circle>
                                        <circle cx="60" cy="60" r="54" fill="none" stroke="#4e73df" stroke-width="8"
                                                stroke-dasharray="@(339.292 * (double)progressPercentage / 100) 339.292"
                                                stroke-linecap="round" transform="rotate(-90 60 60)"></circle>
                                    </svg>
                                    <div class="position-absolute top-50 start-50 translate-middle">
                                        <h3 class="mb-0">@progressPercentage.ToString("0")%</h3>
                                        <small class="text-muted">Complete</small>
                                    </div>
                                </div>
                            </div>
                            <div class="progress mb-2" style="height: 12px;">
                                <div class="progress-bar progress-bar-striped"
                                     role="progressbar"
                                     style="width: @progressPercentage%"
                                     aria-valuenow="@progressPercentage"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>
                            </div>
                            <p class="text-center text-muted small mb-0">
                                @Model.Lessons?.Count(l => completedLessonIds.Contains(l.LessonId)) of @Model.Lessons?.Count lessons completed
                            </p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="card">
                    <div class="card-body text-center enroll-section">
                        <i class="fas fa-lock fa-3x mb-3 text-primary"></i>
                        <h4 class="mb-3">Access Course Content</h4>
                        <p class="text-muted mb-4">Login to enroll in this course and start learning</p>
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-lg btn-block py-3">
                            <i class="fas fa-sign-in-alt mr-2"></i> Login Now
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (isLoggedIn && isEnrolled)
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-book-open mr-2"></i>Course Lessons</h5>
                @if (isAdmin && (!Model.Lessons?.Any() ?? true))
                {
                    <a asp-controller="Lessons" asp-action="Create" asp-route-courseId="@Model.CourseId"
                       class="btn btn-primary btn-sm">
                        <i class="fas fa-plus mr-1"></i> Add First Lesson
                    </a>
                }
            </div>

            @if (Model.Lessons?.Any() ?? false)
            {
                <div class="list-group list-group-flush">
                    @foreach (var lesson in Model.Lessons.OrderBy(l => l.OrderNumber))
                    {
                        bool isCompleted = completedLessonIds.Contains(lesson.LessonId);

                        <a href="@Url.Action("Details", "Lessons", new { courseId = Model.CourseId, lessonId = lesson.LessonId })"
                           class="list-group-item list-group-item-action @(isCompleted ? "list-group-item-success" : "")">
                            <div class="d-flex align-items-center">
                                <div class="lesson-icon">
                                    @if (isCompleted)
                                    {
                                        <i class="fas fa-check-circle text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-circle-notch text-primary"></i>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@lesson.Title</h6>
                                        <small class="text-muted">@lesson.Duration min</small>
                                    </div>
                                    <small class="text-muted">@lesson.ContentType</small>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="card-body">
                    <div class="text-center py-4">
                        <i class="fas fa-book-open fa-3x text-muted mb-3"></i>
                        <h5>No lessons available</h5>
                        <p class="text-muted">This course doesn't have any lessons yet.</p>
                        @if (isAdmin)
                        {
                            <a asp-controller="Lessons" asp-action="Create" asp-route-courseId="@Model.CourseId"
                               class="btn btn-primary mt-2">
                                <i class="fas fa-plus mr-1"></i> Add First Lesson
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>