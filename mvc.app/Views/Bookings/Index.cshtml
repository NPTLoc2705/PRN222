@model IEnumerable<mvc.dataaccess.ViewModels.BookingViewModel>

@{
    ViewData["Title"] = "Index";
}

<div class="layout-container">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <h2 class="sidebar-title">Booking System</h2>
        </div>
        <nav class="sidebar-nav">
            <ul class="nav-list">
                <li class="nav-item active">
                    <a href="#" class="nav-link">
                        <span class="nav-icon">📅</span>
                        <span class="nav-text">Bookings</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link">
                        <span class="nav-icon">👤</span>
                        <span class="nav-text">Customers</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link">
                        <span class="nav-icon">💼</span>
                        <span class="nav-text">Consultants</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link">
                        <span class="nav-icon">⚙️</span>
                        <span class="nav-text">Settings</span>
                    </a>
                </li>
            </ul>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <div class="header-section">
            <h1 class="page-title">Booking Management</h1>
            <p class="page-subtitle">Manage all your bookings efficiently</p>
        </div>

        <div class="table-container">
            <div class="table-wrapper">
                <table class="booking-table">
                    <thead>
                        <tr>
                            <th class="sortable">
                                <div class="th-content">
                                    <span class="th-icon">📅</span>
                                    @Html.DisplayNameFor(model => model.BookingDate)
                                    <span class="sort-indicator">↕</span>
                                </div>
                            </th>
                            <th class="sortable">
                                <div class="th-content">
                                    <span class="th-icon">👤</span>
                                    Customer Name
                                    <span class="sort-indicator">↕</span>
                                </div>
                            </th>
                            <th class="sortable">
                                <div class="th-content">
                                    <span class="th-icon">💼</span>
                                    Consultant Name
                                    <span class="sort-indicator">↕</span>
                                </div>
                            </th>
                            <th class="sortable">
                                <div class="th-content">
                                    <span class="th-icon">🕐</span>
                                    @Html.DisplayNameFor(model => model.StartDate)
                                    <span class="sort-indicator">↕</span>
                                </div>
                            </th>
                            <th class="sortable">
                                <div class="th-content">
                                    <span class="th-icon">📊</span>
                                    @Html.DisplayNameFor(model => model.Status)
                                    <span class="sort-indicator">↕</span>
                                </div>
                            </th>
                            <th class="actions-header">
                                <span class="th-icon">⚙️</span>
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="table-row">
                                <td class="booking-date">
                                    <div class="cell-content">
                                        @Html.DisplayFor(modelItem => item.BookingDate)
                                    </div>
                                </td>
                                <td class="customer-name">
                                    <div class="cell-content">
                                        <span class="data-badge customer-badge">
                                            @Html.DisplayFor(modelItem => item.CustomerName)
                                        </span>
                                    </div>
                                </td>
                                <td class="consultant-name">
                                    <div class="cell-content">
                                        <span class="data-badge consultant-badge">
                                            @Html.DisplayFor(modelItem => item.ConsultantName)
                                        </span>
                                    </div>
                                </td>
                                <td class="start-date">
                                    <div class="cell-content">
                                        @Html.DisplayFor(modelItem => item.StartDate)
                                    </div>
                                </td>
                                <td class="status">
                                    <div class="cell-content">
                                        <span class="status-badge status-active">
                                            @Html.DisplayFor(modelItem => item.Status)
                                        </span>
                                    </div>
                                </td>
                                <td class="actions">
                                    <div class="action-buttons">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn edit-btn">
                                            <span class="action-icon">✏️</span>
                                            <span class="action-text">Edit</span>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="action-btn details-btn">
                                            <span class="action-icon">👁️</span>
                                            <span class="action-text">Details</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn delete-btn">
                                            <span class="action-icon">🗑️</span>
                                            <span class="action-text">Delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<style>
    /* CSS Variables */
    :root {
        --primary-color: #4f46e5;
        --primary-dark: #4338ca;
        --primary-light: #e0e7ff;
        --secondary-color: #f59e0b;
        --success-color: #10b981;
        --danger-color: #ef4444;
        --info-color: #3b82f6;
        --white: #ffffff;
        --gray-50: #f9fafb;
        --gray-100: #f3f4f6;
        --gray-200: #e5e7eb;
        --gray-300: #d1d5db;
        --gray-400: #9ca3af;
        --gray-500: #6b7280;
        --gray-600: #4b5563;
        --gray-700: #374151;
        --gray-800: #1f2937;
        --gray-900: #111827;
        --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        --radius-sm: 0.25rem;
        --radius-md: 0.375rem;
        --radius-lg: 0.5rem;
        --transition-fast: 0.2s ease;
        --transition-normal: 0.3s ease;
    }

    /* Global Styles */
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--gray-100);
        color: var(--gray-800);
        line-height: 1.5;
    }

    /* Layout Container */
    .layout-container {
        display: flex;
        min-height: 100vh;
    }

    /* Sidebar */
    .sidebar {
        width: 250px;
        background: var(--gray-800);
        color: var(--white);
        padding: 1.5rem;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        box-shadow: var(--shadow-md);
    }

    .sidebar-header {
        margin-bottom: 2rem;
    }

    .sidebar-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--primary-light);
    }

    .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .nav-list {
        list-style: none;
    }

    .nav-item {
        border-radius: var(--radius-md);
        transition: all var(--transition-normal);
    }

    .nav-link {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
        color: var(--gray-200);
        text-decoration: none;
        font-size: 1rem;
        font-weight: 500;
        transition: all var(--transition-fast);
    }

        .nav-item.active,
        .nav-link:hover {
            background: var(--primary-dark);
            color: var(--white);
        }

    .nav-icon {
        margin-right: 0.75rem;
        font-size: 1.25rem;
    }

    .nav-text {
        flex-grow: 1;
    }

    /* Main Content */
    .main-content {
        margin-left: 250px;
        flex-grow: 1;
        padding: 2rem;
    }

    .header-section {
        margin-bottom: 2rem;
        text-align: left;
    }

    .page-title {
        font-size: 2.25rem;
        font-weight: 800;
        color: var(--gray-900);
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        font-size: 1.1rem;
        color: var(--gray-500);
        font-weight: 400;
    }

    /* Table Container */
    .table-container {
        background: var(--white);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        overflow: hidden;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    /* Booking Table */
    .booking-table {
        width: 100%;
        border-collapse: collapse;
    }

        .booking-table thead {
            background: var(--gray-50);
            border-bottom: 1px solid var(--gray-200);
        }

        .booking-table th {
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-700);
            font-size: 0.9rem;
            text-transform: uppercase;
        }

    .th-content {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .th-icon {
        font-size: 1rem;
        opacity: 0.8;
    }

    .sortable {
        cursor: pointer;
        transition: all var(--transition-fast);
    }

        .sortable:hover {
            background: var(--gray-100);
            color: var(--primary-color);
        }

    .sort-indicator {
        font-size: 0.8rem;
        opacity: 0.6;
    }

    .actions-header {
        text-align: center;
    }

    .booking-table tbody tr {
        border-bottom: 1px solid var(--gray-200);
        transition: all var(--transition-normal);
    }

    .table-row:hover {
        background: var(--gray-50);
    }

    .booking-table td {
        padding: 1rem;
        vertical-align: middle;
        color: var(--gray-700);
        font-size: 0.9rem;
    }

    .cell-content {
        display: flex;
        align-items: center;
    }

    /* Data Badges */
    .data-badge {
        padding: 0.3rem 0.6rem;
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: var(--radius-sm);
        transition: all var(--transition-fast);
    }

    .customer-badge {
        background: var(--success-color);
        color: var(--white);
    }

    .consultant-badge {
        background: var(--secondary-color);
        color: var(--white);
    }

    .status-badge {
        padding: 0.3rem 0.6rem;
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: var(--radius-sm);
    }

    .status-active {
        background: var(--success-color);
        color: var(--white);
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
    }

    .action-btn {
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: var(--radius-sm);
        text-decoration: none;
        transition: all var(--transition-fast);
        display: flex;
        align-items: center;
    }

    .edit-btn {
        background: var(--info-color);
        color: var(--white);
    }

    .details-btn {
        background: var(--gray-500);
        color: var(--white);
    }

    .delete-btn {
        background: var(--danger-color);
        color: var(--white);
    }

    .action-btn:hover {
        opacity: 0.9;
        transform: translateY(-1px);
    }

    .action-icon {
        margin-right: 0.3rem;
        font-size: 0.9rem;
    }

    /* Scrollbar */
    .table-wrapper::-webkit-scrollbar {
        height: 6px;
    }

    .table-wrapper::-webkit-scrollbar-track {
        background: var(--gray-100);
        border-radius: var(--radius-sm);
    }

    .table-wrapper::-webkit-scrollbar-thumb {
        background: var(--gray-400);
        border-radius: var(--radius-sm);
    }

    /* Accessibility */
    .sortable:focus,
    .action-btn:focus {
        outline: 2px solid var(--primary-color);
        outline-offset: 2px;
    }
</style>