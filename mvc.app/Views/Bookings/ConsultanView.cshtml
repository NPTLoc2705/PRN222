@model IEnumerable<mvc.dataaccess.ViewModels.UserBookingRequest>
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Consultant Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            min-height: 100vh;
            display: flex;
        }

        .sidebar {
            width: 260px;
            background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
            color: #2c3e50;
            min-height: 100vh;
            padding-top: 0;
            box-shadow: 4px 0 15px rgba(0,0,0,0.1);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
        }

        .sidebar-header {
            padding: 30px 20px;
            border-bottom: 1px solid rgba(39,174,96,0.2);
            text-align: center;
        }

            .sidebar-header h4 {
                font-size: 1.4rem;
                font-weight: 600;
                margin-bottom: 0;
                background: linear-gradient(45deg, #27ae60, #2ecc71);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

        .sidebar-nav {
            padding: 20px 0;
        }

            .sidebar-nav a {
                color: #2c3e50;
                display: flex;
                align-items: center;
                padding: 15px 25px;
                text-decoration: none;
                transition: all 0.3s ease;
                border-left: 3px solid transparent;
                cursor: pointer;
            }

                .sidebar-nav a:hover,
                .sidebar-nav a.active {
                    background: rgba(39, 174, 96, 0.1);
                    border-left: 3px solid #27ae60;
                    color: #27ae60;
                    transform: translateX(5px);
                }

                .sidebar-nav a i {
                    margin-right: 12px;
                    font-size: 1.1rem;
                    width: 20px;
                    text-align: center;
                }

        .main-content {
            margin-left: 260px;
            flex: 1;
            background: rgba(255,255,255,0.95);
            margin: 20px;
            margin-left: 280px;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            overflow: hidden;
            min-height: calc(100vh - 40px);
        }

        .content-header {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            padding: 40px;
            text-align: center;
        }

            .content-header h2 {
                font-size: 2.5rem;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .content-header p {
                font-size: 1.2rem;
                opacity: 0.9;
            }

        .content-body {
            padding: 40px;
        }

        .table-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-top: 20px;
        }

        .table-header {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            padding: 20px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .table-header h4 {
                margin: 0;
                font-size: 1.3rem;
            }

        .booking-table {
            width: 100%;
            border-collapse: collapse;
        }

            .booking-table thead {
                background: #f8f9fa;
            }

            .booking-table th {
                padding: 15px 20px;
                text-align: left;
                font-weight: 600;
                color: #2c3e50;
                font-size: 0.9rem;
                border-bottom: 2px solid #e9ecef;
            }

            .booking-table td {
                padding: 15px 20px;
                border-bottom: 1px solid #e9ecef;
                color: #2c3e50;
                vertical-align: middle;
            }

            .booking-table tbody tr {
                transition: all 0.3s ease;
            }

                .booking-table tbody tr:hover {
                    background: rgba(39, 174, 96, 0.05);
                }

        .consultant-avatar {
            width: 40px;
            height: 40px;
            background: #27ae60;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .customer-details {
            min-width: 0;
        }

        .customer-name {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1rem;
            margin-bottom: 0.25rem;
        }

        .customer-email {
            color: #6c757d;
            font-size: 0.875rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .status-badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
            text-transform: uppercase;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-confirmed {
            background: #d4edda;
            color: #155724;
        }

        .status-canceled {
            background: #f8d7da;
            color: #721c24;
        }

        .status-ongoing {
            background: #d1ecf1;
            color: #0c5460;
        }

        .status-complete {
            background: #d4edda;
            color: #155724;
        }

        .action-btn {
            padding: 6px 12px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 0.8rem;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            background: #007bff;
            color: white;
        }

            .action-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #6c757d;
        }

            .empty-state i {
                font-size: 4rem;
                margin-bottom: 20px;
                opacity: 0.5;
            }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-content {
            background: white;
            padding: 2.5rem;
            border-radius: 15px;
            width: 500px;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            position: relative;
        }

        .close {
            position: absolute;
            top: 1rem;
            right: 1.5rem;
            font-size: 2rem;
            cursor: pointer;
            color: #6c757d;
            transition: color 0.3s ease;
        }

            .close:hover {
                color: #dc3545;
            }

        .modal h3 {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 2rem;
            text-align: center;
        }

        .modal-info {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

            .modal-info p {
                margin-bottom: 1rem;
                color: #6c757d;
            }

            .modal-info strong {
                color: #2c3e50;
            }

        .form-group {
            margin-bottom: 1.5rem;
        }

            .form-group label {
                display: block;
                font-weight: 600;
                color: #2c3e50;
                margin-bottom: 0.5rem;
            }

        .form-control {
            width: 100%;
            padding: 1rem;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }

            .form-control:focus {
                outline: none;
                border-color: #27ae60;
                box-shadow: 0 0 0 3px rgba(39, 174, 96, 0.1);
            }

        .btn-action {
            background: #27ae60;
            border: none;
            border-radius: 6px;
            padding: 0.5rem 1rem;
            font-weight: 500;
            color: white;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

            .btn-action:hover {
                background: #219653;
                transform: translateY(-1px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            }

        @@media (max-width: 768px) {
            .sidebar {
                width: 100%;
                height: auto;
                position: static;
                border-bottom: 1px solid rgba(39,174,96,0.2);
            }

            .main-content {
                margin-left: 0;
                margin: 10px;
            }

            .content-header h2 {
                font-size: 2rem;
            }

            .modal-content {
                width: 90%;
                margin: 1rem;
            }

            .booking-table {
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h4><i class="fas fa-user-tie"></i> Consultant Portal</h4>
        </div>
        <nav class="sidebar-nav">
            <a href="#" class="active"><i class="fas fa-calendar-check"></i><span>Bookings</span></a>
            <a href="#"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a>
        </nav>
    </div>

    <div class="main-content">
        <div class="content-header">
            <h2><i class="fas fa-tachometer-alt"></i> Consultant Dashboard</h2>
            <p>View and manage all client bookings</p>
        </div>
        <div class="content-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-container">
                    <div class="table-header">
                        <h4><i class="fas fa-list"></i> All Bookings</h4>
                    </div>
                    <div class="table-wrapper">
                        <table class="booking-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-user"></i> Avatar</th>
                                    <th><i class="fas fa-user"></i> Customer Details</th>
                                    <th><i class="fas fa-calendar"></i> Booking Date</th>
                                    <th><i class="fas fa-phone"></i> Phone Number</th>
                                    <th><i class="fas fa-info-circle"></i> Status</th>
                                    <th><i class="fas fa-cogs"></i> Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var consultant in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="consultant-avatar">
                                                @consultant.UserName?.Substring(0, 1).ToUpper()
                                            </div>
                                        </td>
                                        <td>
                                            <div class="customer-details">
                                                <div class="customer-name">@consultant.UserName</div>
                                                <div class="customer-email">@consultant.Email</div>
                                            </div>
                                        </td>
                                        <td>@consultant.BookingDate.ToString("MMM dd, yyyy")</td>
                                        <td>@consultant.PhoneNumber</td>
                                        <td>
                                            @switch ((int)consultant.Status)
                                            {
                                                case 1:
                                                    <span class="status-badge status-pending">Pending</span>
                                                    break;
                                                case 2:
                                                    <span class="status-badge status-confirmed">Confirmed</span>
                                                    break;
                                                case 3:
                                                    <span class="status-badge status-canceled">Canceled</span>
                                                    break;
                                                case 4:
                                                    <span class="status-badge status-ongoing">Ongoing</span>
                                                    break;
                                                case 5:
                                                    <span class="status-badge status-complete">Complete</span>
                                                    break;
                                                default:
                                                    <span class="status-badge">Unknown</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            <button class="action-btn" onclick="openModal('@consultant.customerId', '@consultant.UserName', '@consultant.Email', '@consultant.PhoneNumber', '@consultant.BookingDate.ToString("yyyy-MM-dd")', '@((int)consultant.Status)')">
                                                <span class="action-icon">✏️</span>
                                                <span class="action-text">Update Status</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-calendar-check"></i>
                    <h3>No Bookings Available</h3>
                    <p>Check back later or contact support for assistance.</p>
                </div>
            }
        </div>
    </div>

    <!-- Modal -->
    <div id="statusModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>
            <h3>Update Booking Status</h3>
            <div class="modal-info">
                <p><strong>Customer Name:</strong> <span id="modalUserName"></span></p>
                <p><strong>Email:</strong> <span id="modalEmail"></span></p>
                <p><strong>Phone:</strong> <span id="modalPhone"></span></p>
                <p><strong>Booking Date:</strong> <span id="modalBookingDate"></span></p>
                <p><strong>Current Status:</strong> <span id="modalCurrentStatus"></span></p>
            </div>
            <form id="statusForm" asp-action="UpdateBookingStatus" asp-controller="Bookings" method="post">
                <input type="hidden" name="customerId" id="modalCustomerId" />
                <div class="form-group">
                    <label for="status">New Status:</label>
                    <select name="Status" id="status" class="form-control">
                        <option value="4">Ongoing</option>
                        <option value="5">Complete</option>
                    </select>
                </div>
                <button type="submit" class="btn-action">Save Status</button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/your-fontawesome-kit.js" crossorigin="anonymous"></script>
    <script>
        function openModal(customerId, userName, email, phone, bookingDate, currentStatus) {
            document.getElementById('modalCustomerId').value = customerId;
            document.getElementById('modalUserName').textContent = userName;
            document.getElementById('modalEmail').textContent = email;
            document.getElementById('modalPhone').textContent = phone;
            document.getElementById('modalBookingDate').textContent = bookingDate;
            document.getElementById('modalCurrentStatus').textContent =
                currentStatus == '1' ? 'Pending' :
                currentStatus == '2' ? 'Confirmed' :
                currentStatus == '3' ? 'Canceled' :
                currentStatus == '4' ? 'Ongoing' :
                currentStatus == '5' ? 'Complete' : 'Unknown';
            document.getElementById('statusModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('statusModal').style.display = 'none';
        }

        document.getElementById('statusForm').addEventListener('submit', function(e) {
            e.preventDefault();
            var formData = new FormData(this);

            fetch(this.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.getElementsByName('__RequestVerificationToken')[0].value
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    closeModal();
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(error => console.error('Error:', error));
        });

        window.addEventListener('click', function(e) {
            var modal = document.getElementById('statusModal');
            if (e.target == modal) {
                modal.style.display = 'none';
            }
        });
    </script>
</body>
</html>