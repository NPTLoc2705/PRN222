@using mvc.dataaccess.ViewModels
@model List<UserBookingRequest>
@{
    ViewData["Title"] = "Book a Consultant";
}

<style>
    .consultant-booking-page {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 2rem 0;
    }

    .page-header {
        text-align: center;
        margin-bottom: 3rem;
        color: white;
    }

        .page-header h2 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

    .page-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
        margin-bottom: 0;
    }

    .consultant-card {
        background: rgba(255, 255, 255, 0.95);
        border: none;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        overflow: hidden;
        backdrop-filter: blur(10px);
        height: 100%;
    }

        .consultant-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
        }

    .card-body {
        padding: 2rem;
        text-align: center;
        position: relative;
    }

    .consultant-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        margin: 0 auto 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: bold;
        color: white;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
    }

    .card-title {
        font-size: 1.4rem;
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 1rem;
    }

    .card-text {
        color: #718096;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }

    .email-info {
        background: #f7fafc;
        padding: 0.75rem;
        border-radius: 10px;
        border-left: 4px solid #667eea;
        margin-bottom: 1rem;
    }

    .btn-book {
        background: linear-gradient(135deg, #667eea, #764ba2);
        border: none;
        border-radius: 25px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        position: relative;
        overflow: hidden;
    }

        .btn-book:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
            color: white;
        }

        .btn-book::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }

        .btn-book:hover::before {
            left: 100%;
        }

    .consultant-grid {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .no-consultants {
        text-align: center;
        color: white;
        font-size: 1.2rem;
        padding: 3rem;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        backdrop-filter: blur(10px);
    }

    .card-body {
        padding: 1.5rem;
    }

    .consultant-avatar {
        width: 60px;
        height: 60px;
        font-size: 1.5rem;
    }

    }

    /* Animation for cards appearing */
    .consultant-card {
        animation: fadeInUp 0.6s ease forwards;
        opacity: 0;
        transform: translateY(30px);
    }

        .consultant-card:nth-child(1) {
            animation-delay: 0.1s;
        }

        .consultant-card:nth-child(2) {
            animation-delay: 0.2s;
        }

        .consultant-card:nth-child(3) {
            animation-delay: 0.3s;
        }

        .consultant-card:nth-child(4) {
            animation-delay: 0.4s;
        }

        .consultant-card:nth-child(5) {
            animation-delay: 0.5s;
        }

        .consultant-card:nth-child(6) {
            animation-delay: 0.6s;
        }

    .consultant-card {
        border-radius: 14px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    }

    .card-body {
        padding: 1rem;
    }

    .consultant-avatar {
        width: 40px;
        height: 40px;
        font-size: 1rem;
        margin-bottom: 1rem;
    }
    
</style>



<!-- (Styles remain unchanged) -->

<div class="consultant-booking-page">
    <div class="consultant-grid">
        <div class="page-header">
            <h2>@ViewData["Title"]</h2>
            <p class="page-subtitle">Choose from our expert consultants to get the guidance you need</p>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row">
                @foreach (var consultant in Model)
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="card consultant-card">
                            <div class="card-body">
                                <div class="consultant-avatar">
                                    @consultant.UserName?.Substring(0, 1).ToUpper()
                                </div>
                                <h5 class="card-title">@consultant.UserName</h5>
                                <div class="card-text">
                                    <div class="email-info">
                                        <strong>📧 Email:</strong> @consultant.Email
                                    </div>
                                    <div class="email-info">
                                        <strong>📧 Email:</strong> @consultant.Email
                                    </div>
                                    <div class="email-info">
                                        <strong>📅 Booking Date:</strong> @consultant.BookingDate.ToString("yyyy-MM-dd")
                                    </div>
                                    <div class="email-info">
                                        <strong>📞 Phone:</strong> @consultant.PhoneNumber
                                    </div>
                                    <!-- Add more consultant details as needed -->
                                </div>
                                <a asp-action="Book" asp-route-consultantId="@consultant.customerId" class="btn btn-book">
                                    Book Consultation
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-consultants">
                <h4>No consultants available at the moment</h4>
                <p>Please check back later or contact us for assistance.</p>
            </div>
        }
    </div>
</div>