@model mvc.dataaccess.ViewModels.LessonDTO
@{
    ViewData["Title"] = "Create Lesson";
    var courseId = ViewBag.CourseId;
}
<style>
    .field-validation-error {
        color: #dc3545;
        font-size: 0.875em;
    }
    </style>
<h1>Create Lesson</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-controller="Lessons"  asp-action="Create" asp-route-courseId="@courseId" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="CourseId" value="@courseId" />

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ContentType" class="control-label"></label>
                <select asp-for="ContentType" class="form-control">
                    <option value="">Select content type</option>
                    <option value="Video">Video</option>
                    <option value="Article">Article</option>
                    <option value="Quiz">Quiz</option>
                    <option value="Exercise">Exercise</option>
                </select>
                <span asp-validation-for="ContentType" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ContentFile" class="control-label">Upload Content</label>
                <input type="file" asp-for="ContentFile" class="form-control"
                       data-val="true"
                       data-val-filesize="The file must be less than 1GB"
                       data-val-filesize-max="1073741824" accept="video/mp4,video/x-m4v,video/*" />
                <span asp-validation-for="ContentFile" class="text-danger"></span>
                <small class="form-text text-muted">Maximum file size: 1GB</small>
            </div>

           

            <div class="form-group mb-3">
                <label asp-for="Duration" class="control-label">Duration (minutes)</label>
                <input asp-for="Duration" class="form-control" />
                <span asp-validation-for="Duration" class="text-danger"></span>
            </div>

            <div class="form-group form-check mb-3">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsFreePreview" />
                    @Html.DisplayNameFor(model => model.IsFreePreview)
                </label>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Create Lesson
                </button>
                <a asp-controller="Admin" asp-action="LessonIndex" asp-route-courseId="@courseId" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $.validator.addMethod('filesize', function (value, element, param) {
            if (element.files.length < 1) {
                // No files selected
                return true;
            }
            return element.files[0].size <= param;
        });

        $.validator.unobtrusive.adapters.add('filesize', ['max'], function (options) {
            options.rules['filesize'] = options.params.max;
            options.messages['filesize'] = options.message;
        });
    </script>
}