<div class="page-header">
    <div class="container">
        <div class="header-content">
            <h1><i class="bi bi-pencil-square"></i> Edit Lesson</h1>
            <p class="header-subtitle mb-0">Update lesson content and settings</p>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <div class="form-container">
                <div class="form-header">
                    <h3><i class="bi bi-file-earmark-text"></i> Lesson Information</h3>
                </div>

                <div class="current-info">
                    <h6><i class="bi bi-info-circle"></i> Current Lesson Details</h6>
                    <p><strong>Title:</strong> @Model.Title</p>
                    <p><strong>Type:</strong> @Model.ContentType</p>
                    <p><strong>Order:</strong> Lesson #@Model.OrderNumber</p>
                    @if (!string.IsNullOrEmpty(Model.ContentUrl))
                    {
                        <p><strong>Content:</strong> <a href="@Model.ContentUrl" target="_blank"><i class="bi bi-link-45deg"></i> View current file</a></p>
                    }
                </div>

                <form asp-controller="Lessons" asp-action="Edit"
                      asp-route-courseId="@courseId"
                      asp-route-lessonId="@Model.LessonId"
                      enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LessonId" />
                    <input type="hidden" asp-for="CourseId" value="@courseId" />
                    <input type="hidden" asp-for="CreatedAt" />

                    <div class="form-group">
                        <label asp-for="Title" class="form-label">
                            Lesson Title <span class="required">*</span>
                        </label>
                        <input asp-for="Title" class="form-control" placeholder="Enter a descriptive title for your lesson" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ContentType" class="form-label">
                            Content Type <span class="required">*</span>
                        </label>
                        <select asp-for="ContentType" class="form-select">
                            <option value="Video">📹 Video</option>
                            <option value="Article">📄 Article</option>
                            <option value="Quiz">📝 Quiz</option>
                            <option value="Exercise">💪 Exercise</option>
                        </select>
                        <span asp-validation-for="ContentType" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ContentFile" class="form-label">Update Content File (Optional)</label>
                        <div class="upload-area">
                            <i class="bi bi-cloud-upload upload-icon"></i>
                            <input type="file" asp-for="ContentFile"
                                   data-val="true"
                                   data-val-filesize="The file must be less than 1GB"
                                   data-val-filesize-max="1073741824"
                                   accept="video/mp4,video/x-m4v,video/*,.pdf,.doc,.docx" />
                            <p class="form-text mb-0 mt-2">
                                <strong>Click to upload or drag and drop</strong><br>
                                Upload a new file to replace the current one<br>
                                <small>Maximum file size: 1GB</small>
                            </p>
                        </div>
                        <span asp-validation-for="ContentFile" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Duration" class="form-label">
                            Duration (minutes) <span class="required">*</span>
                        </label>
                        <input asp-for="Duration" type="number" class="form-control" placeholder="Estimated time to complete" min="1" />
                        <span asp-validation-for="Duration" class="text-danger"></span>
                        <small class="form-text">How long will it take to complete this lesson?</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="OrderNumber" class="form-label">
                            Lesson Order <span class="required">*</span>
                        </label>
                        <input asp-for="OrderNumber" type="number" class="form-control" placeholder="Display order in course" min="1" />
                        <span asp-validation-for="OrderNumber" class="text-danger"></span>
                        <small class="form-text">The position of this lesson in the course sequence</small>
                    </div>

                    <div class="form-check">
                        <input asp-for="IsFreePreview" class="form-check-input" type="checkbox" />
                        <label asp-for="IsFreePreview" class="form-check-label">
                            <strong>Free Preview</strong><br>
                            <small class="text-muted">Allow users to preview this lesson without enrollment</small>
                        </label>
                    </div>

                    <div class="btn-group">
                        <button type="submit" class="btn btn-primary" id="saveBtn">
                            <i class="bi bi-check-circle"></i> Save Changes
                        </button>
                        <a asp-controller="Admin" asp-action="Details" asp-route-id="@courseId" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="info-container">
                <h5><i class="bi bi-info-circle"></i> Lesson Details</h5>

                <div class="info-card">
                    <h6><i class="bi bi-calendar3"></i> Timeline</h6>
                    <div class="info-item">
                        <i class="bi bi-calendar-plus"></i>
                        <span>Created: @Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="info-item">
                        <i class="bi bi-calendar-check"></i>
                        <span>Last Updated: @DateTime.Now.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>

                <div class="info-card">
                    <h6><i class="bi bi-lightbulb"></i> Quick Tips</h6>
                    <ul>
                        <li>Keep the title clear and descriptive</li>
                        <li>Only upload a new file if you want to replace the current one</li>
                        <li>Order numbers should be sequential</li>
                        <li>Free preview lessons help attract new students</li>
                        <li>Review your changes before saving</li>
                    </ul>
                </div>

                <div class="info-card">
                    <h6><i class="bi bi-file-earmark-check"></i> Supported Formats</h6>
                    <ul>
                        <li><strong>Video:</strong> MP4, MOV, AVI</li>
                        <li><strong>Documents:</strong> PDF, DOC, DOCX</li>
                        <li><strong>Maximum size:</strong> 1GB per file</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // File size validation
        $.validator.addMethod('filesize', function (value, element, param) {
            if (element.files.length < 1) {
                return true;
            }
            return element.files[0].size <= param;
        });

        $.validator.unobtrusive.adapters.add('filesize', ['max'], function (options) {
            options.rules['filesize'] = options.params.max;
            options.messages['filesize'] = options.message;
        });

        // File upload preview
        document.querySelector('input[type="file"]').addEventListener('change', function(e) {
            const fileName = e.target.files[0]?.name;
            const fileSize = e.target.files[0]?.size;

            if (fileName) {
                const uploadText = document.querySelector('.upload-area p');
                const sizeInMB = (fileSize / (1024 * 1024)).toFixed(2);
                uploadText.innerHTML = `
                    <strong>Selected:</strong> ${fileName}<br>
                    <small>Size: ${sizeInMB} MB</small><br>
                    <small class="text-warning"><i class="bi bi-exclamation-triangle"></i> This will replace the current file</small>
                `;
            }
        });

        // Drag and drop functionality
        const uploadArea = document.querySelector('.upload-area');
        const fileInput = document.querySelector('input[type="file"]');

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            uploadArea.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        ['dragenter', 'dragover'].forEach(eventName => {
            uploadArea.addEventListener(eventName, highlight, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            uploadArea.addEventListener(eventName, unhighlight, false);
        });

        function highlight(e) {
            uploadArea.style.borderColor = '#388E3C';
            uploadArea.style.backgroundColor = 'rgba(76, 175, 80, 0.15)';
        }

        function unhighlight(e) {
            uploadArea.style.borderColor = '';
            uploadArea.style.backgroundColor = '';
        }

        uploadArea.addEventListener('drop', handleDrop, false);

        function handleDrop(e) {
            const dt = e.dataTransfer;
            const files = dt.files;
            fileInput.files = files;

            const event = new Event('change', { bubbles: true });
            fileInput.dispatchEvent(event);
        }

        // Form submit loading state
        document.querySelector('form').addEventListener('submit', function(e) {
            const saveBtn = document.getElementById('saveBtn');
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Saving...';
            saveBtn.disabled = true;
        });
    </script>
}