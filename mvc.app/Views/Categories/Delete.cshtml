@model mvc.dataaccess.Entities.Courses.CourseCategory

@{
    ViewData["Title"] = "Delete Category";
}

<style>
    body {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        min-height: 100vh;
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .container {
        max-width: 700px;
        width: 100%;
        padding: 20px;
    }

    .card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        overflow: hidden;
    }

    .card-header.bg-danger {
        padding: 20px 30px;
    }

    .card-header h4 {
        margin: 0;
    }

    .card-body {
        background-color: #fff;
        padding: 30px;
    }

    .alert-warning {
        background-color: #fff3cd;
        color: #856404;
        border: 1px solid #ffeeba;
        border-radius: 10px;
        padding: 15px;
    }

    dt {
        font-weight: bold;
        color: #2c3e50;
    }

    dd {
        margin-bottom: 1rem;
    }

    .btn-warning, .btn-secondary {
        border-radius: 10px;
        font-weight: 600;
        padding: 8px 16px;
    }

    .btn-warning {
        margin-top: 10px;
    }

    hr {
        margin: 20px 0;
    }
</style>

<div class="container">
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <h5>Are you sure you want to delete this?</h5>

            @if (ViewBag.CanDelete == false)
            {
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-triangle"></i>
                    This category cannot be deleted because it is associated with one or more courses.
                </div>
            }

            <hr />
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Name)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Name)
                </dd>
                <dt class="col-sm-4">
                    Associated Courses
                </dt>
                <dd class="col-sm-8">
                    @(Model.CourseMappings?.Count ?? 0)
                </dd>
            </dl>

            @if (ViewBag.CanDelete == false)
            {
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-triangle"></i>
                    This category is used by @(Model.CourseMappings?.Count ?? 0) courses and cannot be deleted.
                    <br />
                    <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-warning mt-2">
                        <i class="fas fa-edit"></i> Edit Instead
                    </a>
                </div>
            }
            else
            {
                <a asp-action="Dashboard" asp-controller="Admin" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            }
        </div>
    </div>
</div>
