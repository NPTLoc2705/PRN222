@model mvc.dataaccess.Entities.Courses.CourseCategory

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <h5>Are you sure you want to delete this?</h5>
            @if (ViewBag.CanDelete == false)
            {
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-triangle"></i> This category cannot be deleted because it is associated with one or more courses.
                </div>
            }
            <hr />
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Name)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Name)
                </dd>
                <dt class="col-sm-2">
                    Associated Courses
                </dt>
                <dd class="col-sm-10">
                    @(Model.CourseMappings?.Count ?? 0)
                </dd>
            </dl>

            @if (ViewBag.CanDelete == true)
            {
                <form asp-action="Delete">
                    <input type="hidden" asp-for="CategoryId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </form>
            }
            else
            {
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            }
        </div>
    </div>
</div>