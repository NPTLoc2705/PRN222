@model mvc.dataaccess.Entities.Courses.CourseCategory

@{
    ViewData["Title"] = "Category Details";
}

<style>
    body {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        min-height: 100vh;
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .container {
        width: 100%;
        max-width: 700px;
        padding: 20px;
    }

    .card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    }

    .card-header {
        background-color: #ffffff;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
        padding: 20px 30px;
        border-bottom: 1px solid #ddd;
    }

        .card-header h4 {
            margin: 0;
            color: #2c3e50;
        }

    .card-body {
        background-color: #f9f9f9;
        border-bottom: 1px solid #ddd;
        padding: 30px;
        border-bottom-left-radius: 15px;
        border-bottom-right-radius: 15px;
    }

    .card-footer {
        background-color: #ffffff;
        border-bottom-left-radius: 15px;
        border-bottom-right-radius: 15px;
        padding: 20px 30px;
        display: flex;
        justify-content: flex-end;
    }

    .btn-warning {
        border-radius: 10px;
        margin-right: 10px;
        font-weight: 600;
    }

    .btn-secondary {
        border-radius: 10px;
        font-weight: 600;
    }

    dt {
        font-weight: bold;
        color: #2c3e50;
    }

    dd {
        margin-bottom: 1rem;
    }
</style>

<div class="container">
    <div class="card">
        <div class="card-header">
            <h4>@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Name)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Name)
                </dd>
                <dt class="col-sm-4">
                    Associated Courses
                </dt>
                <dd class="col-sm-8">
                    @(Model.CourseMappings?.Count ?? 0)
                </dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-warning">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a asp-action="Dashboard" asp-controller="Admin" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>
