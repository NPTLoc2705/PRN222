@model IEnumerable<mvc.dataaccess.ViewModels.LessonDTO>
@{
    ViewData["Title"] = "Course Lessons";
    var courseId = ViewBag.CourseId;
    var courseTitle = ViewBag.CourseTitle;
    var userId = Context.Session.GetString("UserId");
    var isLoggedIn = !string.IsNullOrEmpty(userId);
    var isUserEnrolled = ViewBag.IsUserEnrolled ?? false;
    var isAdmin = Context.Session.GetString("UserRole") == "Admin";
}

<style>
    :root {
        --primary-color: #4CAF50;
        --primary-light: #81C784;
        --primary-dark: #388E3C;
        --primary-darker: #2E7D32;
        --primary-bg: #E8F5E9;
        --secondary-color: #6c757d;
        --light-color: #f8f9fa;
        --dark-color: #343a40;
        --success-color: #4CAF50;
        --info-color: #4CAF50;
        --warning-color: #FFC107;
        --danger-color: #dc3545;
        --border-radius: 12px;
        --transition: all 0.3s ease;
    }

    body {
        background-color: #f5f9f5;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card {
        border: none;
        border-radius: var(--border-radius);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        overflow: visible;
        transition: var(--transition);
        background-color: white;
        margin-bottom: 1rem;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
        }

    .card-header {
        background-color: var(--primary-color);
        color: white;
        border-bottom: none;
        padding: 1.5rem;
        font-weight: 500;
        position: relative;
        z-index: 1;
    }

    .card-body {
        min-height: 200px;
        position: relative;
    }

    .list-group-item {
        border: 1px solid rgba(76, 175, 80, 0.1);
        margin-bottom: 0.75rem;
        border-radius: 8px !important;
        transition: var(--transition);
        padding: 1.25rem;
        background-color: white;
        position: relative;
    }

        .list-group-item:last-child {
            margin-bottom: 0;
        }

        .list-group-item:hover {
            background-color: var(--primary-bg);
            transform: translateX(5px);
            box-shadow: 0 2px 8px rgba(76, 175, 80, 0.15);
            border-color: var(--primary-light);
        }

        .list-group-item.bg-light {
            background-color: #f8f9fa !important;
        }

    .btn {
        border-radius: 8px;
        font-weight: 500;
        padding: 0.5rem 1.25rem;
        transition: var(--transition);
    }

    .btn-primary {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
    }

        .btn-primary:hover {
            background-color: var(--primary-dark);
            border-color: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(76, 175, 80, 0.3);
        }

    .btn-outline-primary {
        color: var(--primary-color);
        border-color: var(--primary-color);
        background-color: white;
    }

        .btn-outline-primary:hover {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: white;
            transform: translateY(-1px);
        }

    .btn-light {
        background-color: white;
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: var(--primary-darker);
    }

        .btn-light:hover {
            background-color: var(--primary-bg);
            color: var(--primary-dark);
        }

    .btn-outline-secondary {
        color: var(--secondary-color);
        border-color: #dee2e6;
        background-color: white;
    }

        .btn-outline-secondary:hover {
            background-color: var(--secondary-color);
            border-color: var(--secondary-color);
            color: white;
        }

    .btn-outline-warning {
        color: var(--warning-color);
        border-color: var(--warning-color);
    }

        .btn-outline-warning:hover {
            background-color: var(--warning-color);
            border-color: var(--warning-color);
            color: var(--dark-color);
        }

    .btn-outline-danger {
        color: var(--danger-color);
        border-color: var(--danger-color);
    }

        .btn-outline-danger:hover {
            background-color: var(--danger-color);
            border-color: var(--danger-color);
            color: white;
        }

    .alert {
        border-radius: var(--border-radius);
        border: 1px solid;
        font-weight: 500;
    }

    .alert-info {
        background-color: var(--primary-bg);
        border-color: var(--primary-light);
        color: var(--primary-darker);
    }

        .alert-info .alert-link {
            color: var(--primary-dark);
            font-weight: 600;
        }

    .alert-warning {
        background-color: #FFF8E1;
        border-color: #FFE082;
        color: #F57C00;
    }

        .alert-warning .alert-link {
            color: #E65100;
            font-weight: 600;
        }

    .badge {
        font-weight: 500;
        padding: 0.35em 0.65em;
        border-radius: 50px;
    }

        .badge.bg-secondary {
            background-color: var(--secondary-color) !important;
        }

        .badge.bg-success {
            background-color: var(--primary-color) !important;
        }

        .badge.bg-warning {
            background-color: var(--warning-color) !important;
            color: var(--dark-color);
        }

    h1, h2, h3, h4, h5, h6 {
        color: var(--dark-color);
        font-weight: 600;
    }

    .text-muted {
        color: #6c757d !important;
    }

    .text-dark {
        color: var(--dark-color) !important;
    }

    .text-decoration-none:hover {
        color: var(--primary-color) !important;
    }

    /* Icon colors */
    .fas, .far {
        color: var(--primary-color);
    }

    .card-header .fas,
    .btn .fas,
    .btn .far {
        color: inherit;
    }

    .text-muted .fas {
        color: var(--secondary-color);
    }

    .list-group-item .fas.fa-lock {
        color: var(--secondary-color);
    }

    .alert-info .fas {
        color: var(--primary-dark);
    }

    .alert-warning .fas {
        color: #F57C00;
    }

    /* Enhanced hover effects */
    .btn-group .btn {
        border-radius: 6px !important;
        margin: 0 2px;
    }

    .list-group {
        margin-bottom: 0;
    }

    .list-group-flush {
        border-radius: 0;
    }

    /* Empty state styling */
    .alert.text-center {
        background-color: var(--primary-bg);
        border: 2px dashed var(--primary-light);
        margin: 0;
    }

        .alert.text-center .fas {
            color: var(--primary-color);
        }

    /* Course title */
    .h3.text-dark {
        color: var(--primary-darker) !important;
    }

    /* User info styling */
    .text-muted i.fas.fa-user-circle {
        color: var(--primary-color);
        margin-right: 0.5rem;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .card

    {
        border-radius: 8px;
    }

    .list-group-item {
        padding: 1rem;
    }

    .btn {
        padding: 0.375rem 1rem;
        font-size: 0.875rem;
    }

    }
</style>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-1 text-dark"><i class="fas fa-book-open mr-2"></i> Course Lessons</h1>
                    <p class="text-muted mb-0"><i class="fas fa-graduation-cap mr-2"></i>@courseTitle</p>
                </div>
                @if (isLoggedIn)
                {
                    <div class="text-muted">
                        <i class="fas fa-user-circle mr-1"></i> @Context.Session.GetString("Username")
                    </div>
                }
            </div>
        </div>
    </div>

    @if (!isUserEnrolled && !isAdmin && isLoggedIn)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-info">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas fa-info-circle mr-2"></i>
                            <strong>Enroll to access all lessons</strong> - Only preview lessons are available without enrollment.
                        </div>
                        <form asp-controller="Courses" asp-action="Enroll" method="post">
                            <input type="hidden" name="courseId" value="@courseId" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-user-plus mr-2"></i> Enroll Now
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (!isLoggedIn)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    <strong>Please <a asp-controller="Auth" asp-action="Login" class="alert-link">login</a> to access lessons</strong>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 text-white">
                        <i class="fas fa-play-circle mr-2"></i> Lessons (@Model.Count())
                    </h5>
                    @if (isAdmin)
                    {
                        <a asp-action="Create"
                           asp-route-courseId="@courseId"
                           class="btn btn-light">
                            <i class="fas fa-plus mr-2"></i> Create New Lesson
                        </a>
                    }
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="list-group list-group-flush p-3">
                            @foreach (var item in Model.OrderBy(l => l.OrderNumber))
                            {
                                var canAccess = isUserEnrolled || item.IsFreePreview || isAdmin;

                                <div class="list-group-item @(canAccess ? "" : "bg-light")">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center mb-2">
                                                <span class="badge bg-secondary me-3">@item.OrderNumber</span>

                                                @if (canAccess)
                                                {
                                                    <h6 class="mb-0">
                                                        <a asp-action="Details"
                                                           asp-route-courseId="@courseId"
                                                           asp-route-lessonId="@item.LessonId"
                                                           class="text-decoration-none text-dark">
                                                            @item.Title
                                                        </a>
                                                    </h6>
                                                }
                                                else
                                                {
                                                    <h6 class="mb-0 text-muted">
                                                        <i class="fas fa-lock me-2"></i>
                                                        @item.Title
                                                    </h6>
                                                }

                                                @if (item.IsFreePreview)
                                                {
                                                    <span class="badge bg-success ms-3">
                                                        <i class="fas fa-eye mr-1"></i> Free Preview
                                                    </span>
                                                }
                                                else if (!canAccess)
                                                {
                                                    <span class="badge bg-warning ms-3">
                                                        <i class="fas fa-lock mr-1"></i> Premium
                                                    </span>
                                                }
                                            </div>

                                            <div class="d-flex align-items-center text-muted ps-5">
                                                <small class="me-4">
                                                    <i class="fas fa-play-circle mr-1"></i> @item.ContentType
                                                </small>
                                                <small>
                                                    <i class="fas fa-clock mr-1"></i> @item.Duration min
                                                </small>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center">
                                            @if (canAccess)
                                            {
                                                <a asp-action="Details"
                                                   asp-route-courseId="@courseId"
                                                   asp-route-lessonId="@item.LessonId"
                                                   class="btn btn-outline-primary btn-sm me-2 px-3">
                                                    <i class="fas fa-play mr-1"></i> Watch
                                                </a>
                                            }

                                            @if (isAdmin)
                                            {
                                                <div class="btn-group btn-group-sm">
                                                    <a asp-action="Edit"
                                                       asp-route-courseId="@courseId"
                                                       asp-route-lessonId="@item.LessonId"
                                                       class="btn btn-outline-warning px-3"
                                                       title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a asp-action="Delete"
                                                       asp-route-courseId="@courseId"
                                                       asp-route-lessonId="@item.LessonId"
                                                       class="btn btn-outline-danger px-3"
                                                       title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-4">
                            <div class="alert alert-info text-center py-4">
                                <i class="fas fa-info-circle fa-3x mb-3"></i>
                                <h4 class="mb-3">No lessons found</h4>
                                <p class="mb-4">This course doesn't have any lessons yet.</p>
                                @if (isAdmin)
                                {
                                    <a asp-action="Create"
                                       asp-route-courseId="@courseId"
                                       class="btn btn-primary px-4">
                                        <i class="fas fa-plus mr-2"></i> Create First Lesson
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <a asp-action="Details"
               asp-controller="Courses"
               asp-route-id="@courseId"
               class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left mr-2"></i> Back to Course Details
            </a>
        </div>
    </div>
</div>