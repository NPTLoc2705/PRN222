@model IEnumerable<mvc.dataaccess.ViewModels.BookingViewModel>
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Admin Dashboard - Booking Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            min-height: 100vh;
            display: flex;
        }

        .sidebar {
            width: 260px;
            background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
            color: #2c3e50;
            min-height: 100vh;
            padding-top: 0;
            box-shadow: 4px 0 15px rgba(0,0,0,0.1);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
        }

        .sidebar-header {
            padding: 30px 20px;
            border-bottom: 1px solid rgba(39,174,96,0.2);
            text-align: center;
        }

            .sidebar-header h4 {
                font-size: 1.4rem;
                font-weight: 600;
                margin-bottom: 0;
                background: linear-gradient(45deg, #27ae60, #2ecc71);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

        .sidebar-nav {
            padding: 20px 0;
        }

            .sidebar-nav a {
                color: #2c3e50;
                display: flex;
                align-items: center;
                padding: 15px 25px;
                text-decoration: none;
                transition: all 0.3s ease;
                border-left: 3px solid transparent;
                cursor: pointer;
            }

                .sidebar-nav a:hover,
                .sidebar-nav a.active {
                    background: rgba(39, 174, 96, 0.1);
                    border-left: 3px solid #27ae60;
                    color: #27ae60;
                    transform: translateX(5px);
                }

                .sidebar-nav a i {
                    margin-right: 12px;
                    font-size: 1.1rem;
                    width: 20px;
                    text-align: center;
                }

        .main-content {
            margin-left: 260px;
            flex: 1;
            background: rgba(255,255,255,0.95);
            margin: 20px;
            margin-left: 280px;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            overflow: hidden;
            min-height: calc(100vh - 40px);
        }

        .content-header {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            padding: 40px;
            text-align: center;
        }

            .content-header h2 {
                font-size: 2.5rem;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .content-header p {
                font-size: 1.2rem;
                opacity: 0.9;
            }

        .content-body {
            padding: 40px;
        }

        .welcome-section {
            text-align: center;
            padding: 60px 20px;
            color: #2c3e50;
        }

            .welcome-section h3 {
                font-size: 1.8rem;
                margin-bottom: 20px;
                color: #27ae60;
            }

            .welcome-section p {
                font-size: 1.1rem;
                line-height: 1.6;
                max-width: 600px;
                margin: 0 auto;
            }

        .booking-section {
            display: none;
        }

            .booking-section.active {
                display: block;
            }

        .table-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-top: 20px;
        }

        .table-header {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            padding: 20px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .table-header h4 {
                margin: 0;
                font-size: 1.3rem;
            }

        .btn-create {
            background: rgba(255,255,255,0.2);
            color: white;
            border: 1px solid rgba(255,255,255,0.3);
            padding: 8px 20px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

            .btn-create:hover {
                background: rgba(255,255,255,0.3);
                color: white;
                transform: translateY(-2px);
            }

        .booking-table {
            width: 100%;
            border-collapse: collapse;
        }

            .booking-table thead {
                background: #f8f9fa;
            }

            .booking-table th {
                padding: 15px 20px;
                text-align: left;
                font-weight: 600;
                color: #2c3e50;
                font-size: 0.9rem;
                border-bottom: 2px solid #e9ecef;
            }

            .booking-table td {
                padding: 15px 20px;
                border-bottom: 1px solid #e9ecef;
                color: #2c3e50;
                vertical-align: middle;
            }

            .booking-table tbody tr {
                transition: all 0.3s ease;
            }

                .booking-table tbody tr:hover {
                    background: rgba(39, 174, 96, 0.05);
                }

        .status-badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
            text-transform: uppercase;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-ongoing {
            background: #d4edda;
            color: #155724;
        }

        .status-complete {
            background: #d1ecf1;
            color: #0c5460;
        }

        .action-buttons {
            display: flex;
            gap: 8px;
        }

        .action-btn {
            padding: 6px 12px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 0.8rem;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-edit {
            background: #007bff;
            color: white;
        }

        .btn-details {
            background: #6c757d;
            color: white;
        }

        .btn-delete {
            background: #dc3545;
            color: white;
        }

        .action-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #6c757d;
        }

            .empty-state i {
                font-size: 4rem;
                margin-bottom: 20px;
                opacity: 0.5;
            }

        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            text-align: center;
            transition: transform 0.3s ease;
        }

            .stat-card:hover {
                transform: translateY(-5px);
            }

            .stat-card i {
                font-size: 2.5rem;
                margin-bottom: 15px;
                color: #27ae60;
            }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #6c757d;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h4><i class="fas fa-crown"></i> Admin Panel</h4>
        </div>

        <nav class="sidebar-nav">
            <a href="#" onclick="showSection('welcome')" class="nav-link active">
                <i class="fas fa-tachometer-alt"></i>
                <span>Dashboard</span>
            </a>
            <a href="#" onclick="showSection('bookings')" class="nav-link">
                <i class="fas fa-calendar-check"></i>
                <span>Booking Management</span>
            </a>
            <a href="#" onclick="showSection('blogs')" class="nav-link">
                <i class="fas fa-blog"></i>
                <span>Blog Management</span>
            </a>
            <a href="#" onclick="showSection('customers')" class="nav-link">
                <i class="fas fa-users"></i>
                <span>User</span>
            </a>
            <a href="#" onclick="showSection('settings')" class="nav-link">
                <i class="fas fa-cog"></i>
                <span>Settings</span>
            </a>
        </nav>
    </div>

    <div class="main-content">
        <!-- Welcome Section -->
        <div id="welcome-section" class="content-section active">
            <div class="content-header">
                <h2><i class="fas fa-tachometer-alt"></i> Welcome to the Admin Dashboard</h2>
                <p>Manage your application with ease and style</p>
            </div>
            <div class="content-body">
                <div class="stats-container">
                    <div class="stat-card">
                        <i class="fas fa-calendar-check"></i>
                        <div class="stat-number">24</div>
                        <div class="stat-label">Total Bookings</div>
                    </div>
                    <div class="stat-card">
                        <i class="fas fa-clock"></i>
                        <div class="stat-number">8</div>
                        <div class="stat-label">Pending Bookings</div>
                    </div>
                    <div class="stat-card">
                        <i class="fas fa-users"></i>
                        <div class="stat-number">156</div>
                        <div class="stat-label">Total Customers</div>
                    </div>
                    <div class="stat-card">
                        <i class="fas fa-user-tie"></i>
                        <div class="stat-number">12</div>
                        <div class="stat-label">Active Consultants</div>
                    </div>
                </div>
                <div class="welcome-section">
                    <h3>System Overview</h3>
                </div>
            </div>
        </div>

        <!-- Bookings Section -->
        <div id="bookings-section" class="content-section booking-section">
            <div class="content-header">
                <h2><i class="fas fa-calendar-check"></i> Booking Management</h2>
                <p>Manage all your bookings efficiently</p>
            </div>
            <div class="content-body">
                <div class="table-container">
                    <div class="table-header">
                        <h4><i class="fas fa-list"></i> All Bookings</h4>
                        <a href="#" class="btn-create" onclick="createBooking()">
                            <i class="fas fa-plus"></i> Create New Booking
                        </a>
                    </div>
                    <div class="table-wrapper">
                        <table class="booking-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-calendar"></i> Booking Date</th>
                                    <th><i class="fas fa-user"></i> Customer Name</th>
                                    <th><i class="fas fa-user-tie"></i> Consultant Name</th>
                                    <th><i class="fas fa-clock"></i> Start Date</th>
                                    <th><i class="fas fa-info-circle"></i> Status</th>
                                    <th><i class="fas fa-phone"></i> Phone</th>
                                    <th><i class="fas fa-cogs"></i> Actions</th>
                                </tr>
                            </thead>
                            <tbody id="bookingsTableBody">
                                @foreach (var item in Model)
                                {
                                    <tr class="table-row">
                                        <td class="booking-date">
                                            <div class="cell-content">
                                                @Html.DisplayFor(modelItem => item.BookingDate)
                                            </div>
                                        </td>
                                        <td class="customer-name">
                                            <div class="cell-content">
                                                <span class="data-badge customer-badge">
                                                    @Html.DisplayFor(modelItem => item.CustomerName)
                                                </span>
                                            </div>
                                        </td>
                                        <td class="consultant-name">
                                            <div class="cell-content">
                                                <span class="data-badge consultant-badge">
                                                    @Html.DisplayFor(modelItem => item.ConsultantName)
                                                </span>
                                            </div>
                                        </td>
                                        <td class="start-date">
                                            <div class="cell-content">
                                                @Html.DisplayFor(modelItem => item.StartDate)
                                            </div>
                                        </td>
                                        <td class="status">
                                            <div class="cell-content">
                                                <span class="status-badge status-active">
                                                    @Html.DisplayFor(modelItem => item.Status)
                                                </span>
                                            </div>
                                        </td>
                                        <td class="phone">
                                            <div class="cell-content">
                                                <span class="status-badge status-active">
                                                    @Html.DisplayFor(modelItem => item.Phone)
                                                </span>
                                            </div>
                                        </td>
                                        <td class="actions">
                                            <div class="action-buttons">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn edit-btn">
                                                    <span class="action-icon">✏️</span>
                                                    <span class="action-text">Edit</span>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="action-btn details-btn">
                                                    <span class="action-icon">👁️</span>
                                                    <span class="action-text">Details</span>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn delete-btn">
                                                    <span class="action-icon">🗑️</span>
                                                    <span class="action-text">Delete</span>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Other Sections (Placeholder) -->
        <div id="blogs-section" class="content-section" style="display: none;">
            <div class="content-header">
                <h2><i class="fas fa-blog"></i> Blog Management</h2>
                <p>Manage your blog content</p>
            </div>
            <div class="content-body">
                <div class="empty-state">
                    <i class="fas fa-blog"></i>
                    <h3>Blog Management</h3>
                    <p>Blog management functionality will be implemented here.</p>
                </div>
            </div>
        </div>

        <div id="customers-section" class="content-section" style="display: none;">
            <div class="content-header">
                <h2><i class="fas fa-users"></i> Customer Management</h2>
                <p>Manage your customers</p>
            </div>
            <div class="content-body">
                <div class="empty-state">
                    <i class="fas fa-users"></i>
                    <h3>Customer Management</h3>
                    <p>Customer management functionality will be implemented here.</p>
                </div>
            </div>
        </div>

        <div id="consultants-section" class="content-section" style="display: none;">
            <div class="content-header">
                <h2><i class="fas fa-user-tie"></i> Consultant Management</h2>
                <p>Manage your consultants</p>
            </div>
            <div class="content-body">
                <div class="empty-state">
                    <i class="fas fa-user-tie"></i>
                    <h3>Consultant Management</h3>
                    <p>Consultant management functionality will be implemented here.</p>
                </div>
            </div>
        </div>

        <div id="settings-section" class="content-section" style="display: none;">
            <div class="content-header">
                <h2><i class="fas fa-cog"></i> Settings</h2>
                <p>Configure your application</p>
            </div>
            <div class="content-body">
                <div class="empty-state">
                    <i class="fas fa-cog"></i>
                    <h3>Settings</h3>
                    <p>Application settings will be implemented here.</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        function showSection(sectionName) {
            // Hide all sections
            const sections = document.querySelectorAll('.content-section');
            sections.forEach(section => {
                section.style.display = 'none';
                section.classList.remove('active');
            });

            // Show selected section
            const targetSection = document.getElementById(sectionName + '-section');
            if (targetSection) {
                targetSection.style.display = 'block';
                targetSection.classList.add('active');
            }

            // Update active nav link
            const navLinks = document.querySelectorAll('.nav-link');
            navLinks.forEach(link => link.classList.remove('active'));

            // Find and activate the clicked nav link
            const clickedLink = event ? event.target.closest('.nav-link') : document.querySelector('.nav-link');
            if (clickedLink) {
                clickedLink.classList.add('active');
            }
        }

        function createBooking() {
            alert('Redirect to Create Booking page');
            // window.location.href = '/Bookings/Create';
        }

        function editBooking(id) {
            alert(`Edit booking with ID: ${id}`);
            // window.location.href = `/Bookings/Edit/${id}`;
        }

        function viewDetails(id) {
            alert(`View details for booking ID: ${id}`);
            // window.location.href = `/Bookings/Details/${id}`;
        }

        function deleteBooking(id) {
            if (confirm('Are you sure you want to delete this booking?')) {
                alert(`Delete booking with ID: ${id}`);
                // window.location.href = `/Bookings/Delete/${id}`;
            }
        }

        // Initialize with welcome section
        document.addEventListener('DOMContentLoaded', function() {
            showSection('welcome');
        });
    </script>
</body>
</html>