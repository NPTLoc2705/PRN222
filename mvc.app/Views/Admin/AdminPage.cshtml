<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Admin Page</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            min-height: 100vh;
            display: flex;
        }

        .sidebar {
            width: 260px;
            background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
            color: #2c3e50;
            min-height: 100vh;
            padding-top: 0;
            box-shadow: 4px 0 15px rgba(0,0,0,0.1);
            position: relative;
        }

        .sidebar-header {
            padding: 30px 20px;
            border-bottom: 1px solid rgba(39,174,96,0.2);
            text-align: center;
            position: relative;
            z-index: 1;
        }

            .sidebar-header h4 {
                font-size: 1.4rem;
                font-weight: 600;
                margin-bottom: 0;
                background: linear-gradient(45deg, #27ae60, #2ecc71);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

        .sidebar-nav {
            padding: 20px 0;
            position: relative;
            z-index: 1;
        }

            .sidebar-nav a {
                color: #2c3e50;
                display: flex;
                align-items: center;
                padding: 15px 25px;
                text-decoration: none;
                transition: all 0.3s ease;
                border-left: 3px solid transparent;
                position: relative;
            }

                .sidebar-nav a:hover {
                    background: rgba(39, 174, 96, 0.1);
                    border-left: 3px solid #27ae60;
                    color: #27ae60;
                    transform: translateX(5px);
                }

                .sidebar-nav a i {
                    margin-right: 12px;
                    font-size: 1.1rem;
                    width: 20px;
                    text-align: center;
                }

        .content {
            flex: 1;
            background: rgba(255,255,255,0.95);
            margin: 20px;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .content-header {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            padding: 60px 40px;
            text-align: center;
            position: relative;
        }

            .content-header h2 {
                font-size: 2.5rem;
                font-weight: 700;
                margin-bottom: 10px;
                position: relative;
                z-index: 1;
            }

            .content-header p {
                font-size: 1.2rem;
                opacity: 0.9;
                position: relative;
                z-index: 1;
            }

        .content-body {
            flex: 1;
            padding: 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .welcome-text {
            color: #2c3e50;
            font-size: 1.3rem;
            font-weight: 300;
            line-height: 1.6;
            max-width: 600px;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h4><i class="fas fa-crown"></i> Admin Panel</h4>
        </div>

        <nav class="sidebar-nav">
            <a asp-controller="Bookings" asp-action="Index">
                <i class="fas fa-calendar-check"></i>
                <span>Booking Management</span>
            </a>
            <a asp-controller="Blogs" asp-action="Index">
                <i class="fas fa-blog"></i>
                <span>Blog Management</span>
            </a>
        </nav>
    </div>

    <div class="content">
        <div class="content-header">
            <h2><i class="fas fa-tachometer-alt"></i> Welcome to the Admin Dashboard</h2>
            <p>Manage your application with ease and style</p>
        </div>

        <div class="content-body">
            <div class="welcome-text">
                Select an action from the sidebar to get started with managing your application.
            </div>
        </div>
    </div>
</body>
</html>