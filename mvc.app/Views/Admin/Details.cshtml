@model mvc.dataaccess.Entities.Courses.Course
@{
    ViewData["Title"] = "Manager - Course Details";
    var isManager = Context.Session.GetString("UserRole") == "Admin";
}

<style>
    .manager-course-header {
        background-color: #f1f5f9;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .lesson-list-item {
        border-left: 4px solid #3b82f6;
        transition: all 0.2s ease;
    }

        .lesson-list-item:hover {
            transform: translateX(5px);
            background-color: #f8fafc;
        }
</style>

@if (!isManager)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle mr-2"></i>
        You don't have permission to access this area.
    </div>
}
else
{
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="fas fa-book mr-2"></i>@Model.Title</h2>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left mr-2"></i> Back to Dashboard
            </a>
        </div>

        <div class="manager-course-header">
            <div class="row">
                <div class="col-md-8">
                    <h4>Course Information</h4>
                    <p class="text-muted">@Model.Description</p>

                    <div class="row mt-3">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <h6 class="text-muted">Status</h6>
                                <p>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <h6 class="text-muted">Difficulty</h6>
                                <p>@Model.DifficultyLevel</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <h6 class="text-muted">Duration</h6>
                                <p>@Model.Duration minutes</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <div class="btn-group-vertical">
                        <a asp-action="Edit" asp-controller="Courses" asp-route-id="@Model.CourseId" class="btn btn-primary mb-2">
                            <i class="fas fa-edit mr-2"></i>Edit Course
                        </a>
                        <a asp-controller="Lessons" asp-action="Create" asp-route-courseId="@Model.CourseId"
                           class="btn btn-success mb-2">
                            <i class="fas fa-plus mr-2"></i>Add Lesson
                        </a>
                        <a asp-action="Delete" asp-controller="Courses" asp-route-id="@Model.CourseId" class="btn btn-danger">
                            <i class="fas fa-trash mr-2"></i>Delete Course
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-book-open mr-2"></i>Lessons</h5>
            </div>
            <div class="card-body">
                @if (Model.Lessons?.Any() == true)
                {
                    <div class="list-group">
                        @foreach (var lesson in Model.Lessons.OrderBy(l => l.OrderNumber))
                        {
                            <div class="list-group-item lesson-list-item mb-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@lesson.Title</h6>
                                        <small class="text-muted">
                                            <i class="fas fa-clock mr-1"></i> @lesson.Duration min |
                                            <i class="fas fa-tag mr-1"></i> @lesson.ContentType
                                        </small>
                                    </div>
                                    <div class="btn-group">
                                        <a asp-controller="Lessons" asp-action="Details"
                                           asp-route-courseId="@Model.CourseId" asp-route-lessonId="@lesson.LessonId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-controller="Lessons" asp-action="Edit"
                                           asp-route-courseId="@Model.CourseId" asp-route-lessonId="@lesson.LessonId"
                                           class="btn btn-sm btn-outline-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-controller="Lessons" asp-action="Delete"
                                           asp-route-courseId="@Model.CourseId" asp-route-lessonId="@lesson.LessonId"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle mr-2"></i> No lessons found for this course.
                    </div>
                }
            </div>
        </div>
    </div>
}