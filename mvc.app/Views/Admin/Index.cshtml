@model IEnumerable<mvc.dataaccess.Entities.Courses.Course>
@{
    ViewData["Title"] = "Course Management Dashboard";
    var isAdmin = Context.Session.GetString("UserRole") == "Admin";
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}

<style>
    :root {
        --primary-color: #4CAF50;
        --primary-hover: #45a049;
        --primary-light: #e8f5e9;
        --primary-dark: #2e7d32;
        --secondary-color: #6c757d;
        --light-bg: #f0fdf4;
        --card-shadow: 0 2px 8px rgba(0,0,0,0.05);
        --transition: all 0.3s ease;
    }

    .management-dashboard {
        padding: 1.5rem;
        background-color: var(--light-bg);
        min-height: calc(100vh - 100px);
    }

    .content-wrapper {
        max-width: 1400px;
        margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
    }

    .back-button {
        background: white;
        border: 1px solid #e0e0e0;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        color: #495057;
        text-decoration: none;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .back-button:hover {
        background: #f8f9fa;
        border-color: var(--primary-color);
        color: var(--primary-color);
        text-decoration: none;
        transform: translateX(-3px);
    }

    .management-header {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-hover) 100%);
        padding: 2rem;
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        margin-bottom: 1.5rem;
        color: white;
    }

    .management-title {
        font-weight: 600;
        color: white;
        margin-bottom: 0.5rem;
        font-size: 1.75rem;
    }

    .management-subtitle {
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 0;
    }

    .stats-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: var(--card-shadow);
        margin-bottom: 2rem;
        border: 1px solid rgba(76, 175, 80, 0.1);
    }

    .stat-item {
        text-align: center;
        padding: 0.5rem;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        color: var(--secondary-color);
        font-size: 0.875rem;
        font-weight: 500;
    }

    .management-table {
        background: white;
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        overflow: hidden;
        border: 1px solid rgba(76, 175, 80, 0.1);
        max-width: 100%;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    }

    .table-container {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
         width: 100%;
    }

    .table {
        margin-bottom: 0;
        width: 100%;
    }

    .table thead th {
        background-color: var(--light-bg);
        border-bottom: 2px solid var(--primary-light);
        font-weight: 600;
        color: var(--primary-dark);
        padding: 1rem 0.75rem;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .table td {
        padding: 1rem 0.75rem;
        vertical-align: middle;
        border-bottom: 1px solid #f5f5f5;
    }

    .table tbody tr:hover {
        background-color: rgba(76, 175, 80, 0.02);
    }

    .table tbody tr:last-child td {
        border-bottom: none;
    }

    /* Thumbnail styles */
    .course-thumbnail {
        width: 60px;
        height: 45px;
        object-fit: cover;
        border-radius: 6px;
        border: 2px solid var(--primary-light);
        display: inline-block;
    }

    .course-thumbnail-placeholder {
        width: 60px;
        height: 45px;
        background: var(--primary-light);
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* Course info styles */
    .course-title {
        font-weight: 600;
        color: var(--primary-dark);
        font-size: 0.95rem;
        word-break: break-word;
    }

    .course-description {
        color: var(--secondary-color);
        font-size: 0.85rem;
        line-height: 1.4;
        max-height: 2.8em;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    /* Badges */
    .status-badge {
        font-weight: 500;
        padding: 0.3rem 0.6rem;
        font-size: 0.75rem;
        border-radius: 20px;
    }

    .badge-published {
        background: rgba(40, 167, 69, 0.1);
        color: #28a745;
    }

    .badge-inactive {
        background: rgba(108, 117, 125, 0.1);
        color: var(--secondary-color);
    }

    .difficulty-badge {
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .difficulty-beginner {
        background: rgba(40, 167, 69, 0.1);
        color: #28a745;
    }

    .difficulty-intermediate {
        background: rgba(255, 193, 7, 0.1);
        color: #ffc107;
    }

    .difficulty-advanced {
        background: rgba(220, 53, 69, 0.1);
        color: #dc3545;
    }

    /* Action buttons */
    .action-buttons {
        display: flex;
        gap: 0.25rem;
        justify-content: center;
    }

    .action-buttons .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        border-radius: 4px;
        transition: var(--transition);
    }

    .action-buttons .btn:hover {
        transform: translateY(-1px);
    }

    .btn-create {
        background: white;
        color: var(--primary-color);
        border: 2px solid white;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
        border-radius: 8px;
        transition: var(--transition);
    }

    .btn-create:hover {
        background: rgba(255, 255, 255, 0.95);
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    /* Empty state */
    .empty-state {
        background: white;
        border-radius: 12px;
        padding: 3rem;
        text-align: center;
        box-shadow: var(--card-shadow);
        border: 1px solid rgba(76, 175, 80, 0.1);
    }

    .empty-state-icon {
        font-size: 4rem;
        color: var(--primary-light);
        margin-bottom: 1rem;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .management-header {
            padding: 1.5rem;
        }
        
        .stats-card {
            padding: 1rem;
        }
        
        .stat-value {
            font-size: 1.5rem;
        }

        .table {
            font-size: 0.875rem;
        }

        .course-title {
            font-size: 0.875rem;
        }

        .course-description {
            font-size: 0.8rem;
        }
    }
</style>

<div class="management-dashboard">
    <div class="content-wrapper">
        @if (!isAdmin)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Access Denied:</strong> Administrator privileges required
            </div>
        }
        else
        {
            <!-- Back to Admin Button -->
            <a href="@Url.Action("DashBoard", "Admin")" class="back-button">
                <i class="fas fa-arrow-left"></i>
                Back to Admin Dashboard
            </a>

            <!-- Header -->
            <div class="management-header">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="management-title">
                            <i class="fas fa-book-open me-2"></i>Course Management
                        </h2>
                        <p class="management-subtitle">
                            Manage course content, visibility, and publishing status
                        </p>
                    </div>
                    <div>
                        <a asp-controller="Courses" asp-action="Create" class="btn btn-create">
                            <i class="fas fa-plus me-2"></i>Create Course
                        </a>
                    </div>
                </div>
            </div>

            <!-- Statistics -->
            <div class="row stats-card">
                <div class="col-md-3 stat-item border-end">
                    <div class="stat-value text-dark">@Model.Count()</div>
                    <div class="stat-label">Total Courses</div>
                </div>
                <div class="col-md-3 stat-item border-end">
                    <div class="stat-value text-success">@Model.Count(c => c.IsActive)</div>
                    <div class="stat-label">Published</div>
                </div>
                <div class="col-md-3 stat-item border-end">
                    <div class="stat-value text-secondary">@Model.Count(c => !c.IsActive)</div>
                    <div class="stat-label">Draft</div>
                </div>
                <div class="col-md-3 stat-item">
                    <div class="stat-value text-info">@Model.Sum(c => c.Lessons?.Count ?? 0)</div>
                    <div class="stat-label">Total Lessons</div>
                </div>
            </div>

            <!-- Courses Table -->
            <div class="management-table">
                @if (!Model.Any())
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i class="fas fa-book-open"></i>
                        </div>
                        <h5 class="mb-3">No courses available</h5>
                        <p class="text-muted mb-4">Get started by creating your first course</p>
                        <a asp-controller="Courses" asp-action="Create" class="btn btn-primary px-4">
                            <i class="fas fa-plus me-2"></i>Create Your First Course
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-container">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th style="width: 80px;" class="text-center">Thumbnail</th>
                                    <th style="min-width: 150px;">Title</th>
                                    <th style="min-width: 250px;">Description</th>
                                    <th style="width: 100px;" class="text-center">Status</th>
                                    <th style="width: 110px;" class="text-center">Difficulty</th>
                                    <th style="width: 80px;" class="text-center">Lessons</th>
                                    <th style="width: 100px;" class="text-center">Duration</th>
                                    <th style="width: 110px;" class="text-center">Created</th>
                                    <th style="width: 140px;" class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var course in Model.OrderByDescending(c => c.CreatedAt))
                                {
                                    <tr>
                                        <td class="text-center">
                                            @if (course.ImageBytes != null && course.ImageBytes.Length > 0)
                                            {
                                                <img src="@Url.Action("GetCourseImage", "Courses", new { id = course.CourseId })"
                                                     alt="@course.Title" class="course-thumbnail" />
                                            }
                                            else
                                            {
                                                <div class="course-thumbnail-placeholder">
                                                    <i class="fas fa-image text-muted"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div class="course-title">@course.Title</div>
                                        </td>
                                        <td>
                                            <div class="course-description">
                                                @{
                                                    var cleanDescription = course.Description?
                                                        .Replace("<p>", "")
                                                        .Replace("</p>", "")
                                                        .Replace("<p/>", "")
                                                        .Replace("<br>", " ")
                                                        .Replace("<br/>", " ")
                                                        .Replace("&nbsp;", " ")
                                                        .Trim() ?? "";
                                                    
                                                    // Remove any remaining HTML tags
                                                    cleanDescription = System.Text.RegularExpressions.Regex.Replace(cleanDescription, "<.*?>", "");
                                                }
                                                @cleanDescription
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="status-badge @(course.IsActive ? "badge-published" : "badge-inactive")">
                                                @(course.IsActive ? "Published" : "Inactive")
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="difficulty-badge @($"difficulty-{course.DifficultyLevel?.ToLower()}")">
                                                @course.DifficultyLevel
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary">@(course.Lessons?.Count ?? 0)</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="text-nowrap">
                                                <i class="far fa-clock text-muted me-1"></i>@course.Duration min
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="text-nowrap">@course.CreatedAt.ToString("MMM dd, yyyy")</span>
                                        </td>
                                        <td>
                                            <div class="action-buttons">
                                                <a asp-action="Details" asp-route-id="@course.CourseId"
                                                   class="btn btn-sm btn-outline-primary" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-controller="Courses" asp-action="Edit" asp-route-id="@course.CourseId"
                                                   class="btn btn-sm btn-outline-warning" title="Edit Course">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-controller="Courses" asp-action="Delete" asp-route-id="@course.CourseId"
                                                   class="btn btn-sm btn-outline-danger" title="Delete Course">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
</div>